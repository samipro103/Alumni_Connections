/*
 * ALUMNI 1.4.0 — FEED PRO
 * One scoped visual system for /feed.
 */

.alumni-feed-pro {
  --feed-gap: 18px;
}

/* ---------------------------------------------------------
   Open composer
   --------------------------------------------------------- */
.alumni-pro-composer {
  margin-bottom: 18px;
  padding: 12px 0 16px;
  border-bottom: 1px solid var(--app-border);
  background: transparent !important;
  box-shadow: none !important;
}

.alumni-pro-composer-row {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.alumni-pro-composer-avatar,
.alumni-pro-avatar {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 999px;
  background: var(--app-surface-2);
  color: var(--app-text);
  font-weight: 850;
  box-shadow: none !important;
  border: 1px solid var(--app-border);
}

.alumni-pro-composer-avatar {
  width: 44px;
  height: 44px;
  font-size: 13px;
}

.alumni-pro-composer-avatar img,
.alumni-pro-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.alumni-pro-composer-open {
  flex: 1 1 auto;
  min-width: 0;
  min-height: 44px;
  padding: 0 4px;
  border: 0;
  background: transparent;
  color: var(--app-muted);
  font-size: 14px;
  text-align: left;
}

.alumni-pro-composer-open:hover {
  color: var(--app-text-soft);
}

.alumni-pro-composer-media-shortcut {
  display: inline-flex;
  width: 42px;
  height: 42px;
  flex: 0 0 42px;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: var(--app-accent);
}

.alumni-pro-composer-media-shortcut:hover {
  background: var(--app-accent-soft);
}

.alumni-pro-composer-main {
  min-width: 0;
  flex: 1 1 auto;
}

.alumni-pro-composer-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}

.alumni-pro-composer-meta strong {
  color: var(--app-text);
  font-size: 13px;
}

.alumni-pro-composer-meta span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: var(--app-muted-2);
  font-size: 10px;
  font-weight: 700;
}

.alumni-pro-composer-main textarea {
  width: 100%;
  min-height: 96px;
  resize: none;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--app-text);
  font: inherit;
  font-size: 16px;
  line-height: 1.55;
}

.alumni-pro-composer-main textarea::placeholder {
  color: var(--app-muted-2);
}

.alumni-pro-composer-previews {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 4px 0 8px;
  scrollbar-width: none;
}

.alumni-pro-composer-previews::-webkit-scrollbar {
  display: none;
}

.alumni-pro-composer-preview,
.alumni-pro-composer-add-more {
  position: relative;
  flex: 0 0 118px;
  width: 118px;
  height: 118px;
  overflow: hidden;
  border-radius: 14px;
  border: 1px solid var(--app-border);
  background: var(--app-soft);
}

.alumni-pro-composer-preview img,
.alumni-pro-composer-preview video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.alumni-pro-composer-preview > button {
  position: absolute;
  top: 6px;
  right: 6px;
  display: inline-flex;
  width: 28px;
  height: 28px;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 999px;
  background: rgba(5, 7, 11, .68);
  color: white;
}

.alumni-pro-composer-video-badge,
.alumni-pro-composer-order {
  position: absolute;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: rgba(5, 7, 11, .62);
  color: white;
  backdrop-filter: blur(8px);
}

.alumni-pro-composer-video-badge {
  left: 7px;
  bottom: 7px;
  width: 28px;
  height: 28px;
}

.alumni-pro-composer-order {
  right: 7px;
  bottom: 7px;
  min-width: 25px;
  height: 25px;
  padding: 0 7px;
  font-size: 10px;
  font-weight: 800;
}

.alumni-pro-composer-add-more {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  color: var(--app-muted);
}

.alumni-pro-composer-add-more span {
  font-size: 10px;
  font-weight: 750;
}

.alumni-pro-composer-footer {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 8px;
  padding-top: 10px;
  border-top: 1px solid var(--app-border);
}

.alumni-pro-composer-media-button {
  display: inline-flex;
  min-height: 38px;
  align-items: center;
  gap: 7px;
  padding: 0 9px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: var(--app-accent);
  font-size: 11px;
  font-weight: 800;
}

.alumni-pro-composer-media-button:hover {
  background: var(--app-accent-soft);
}

.alumni-pro-composer-limit {
  color: var(--app-muted-3);
  font-size: 10px;
}

.alumni-pro-composer-submit {
  display: flex;
  align-items: center;
  gap: 5px;
  margin-left: auto;
}

.alumni-pro-composer-submit > button {
  min-height: 38px;
  padding: 0 12px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: var(--app-muted);
  font-size: 11px;
  font-weight: 800;
}

.alumni-pro-composer-submit > button.is-primary {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding-inline: 14px;
  background: var(--app-accent-fill);
  color: var(--app-on-accent);
}

.alumni-pro-composer-submit > button:disabled {
  cursor: not-allowed;
  opacity: .42;
}

/* ---------------------------------------------------------
   Feed tabs / empty states
   --------------------------------------------------------- */
.alumni-pro-feed-tabs {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-bottom: 4px;
  border-bottom: 1px solid var(--app-border);
}

.alumni-pro-feed-tabs button {
  position: relative;
  min-height: 44px;
  padding: 0 1px;
  border: 0;
  background: transparent;
  color: var(--app-muted-2);
  font-size: 12px;
  font-weight: 820;
}

.alumni-pro-feed-tabs button[data-active="true"] {
  color: var(--app-text);
}

.alumni-pro-feed-tabs button[data-active="true"]::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: -1px;
  left: 0;
  height: 2px;
  border-radius: 999px;
  background: var(--app-accent);
}

.alumni-pro-feed-status {
  padding: 48px 0;
  color: var(--app-muted-2);
  font-size: 13px;
  text-align: center;
}

.alumni-pro-feed-list {
  display: block;
}

.alumni-pro-feed-list > div + div {
  border-top: 1px solid var(--app-border);
}

.alumni-feed-post-viewport {
  content-visibility: auto;
  contain-intrinsic-size: auto 720px;
}

.alumni-pro-post-focus {
  animation: alumni-pro-focus 1.8s ease;
}

@keyframes alumni-pro-focus {
  0%, 100% {
    background: transparent;
  }
  18% {
    background: var(--app-accent-soft);
  }
}

/* ---------------------------------------------------------
   Post — flat, editorial
   --------------------------------------------------------- */
.alumni-feed-page .alumni-pro-post,
.alumni-feed-page .alumni-post-card,
.alumni-feed-page .alumni-post-card:hover {
  border: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  background-image: none !important;
  box-shadow: none !important;
  filter: none !important;
}

.alumni-pro-post {
  position: relative;
  padding: 17px 0 19px;
}

.alumni-pro-repost-label {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: 0 0 8px 55px;
  color: var(--app-muted-2);
  font-size: 12px;
  font-weight: 740;
}

.alumni-pro-repost-label a {
  color: var(--app-text-soft);
}

.alumni-pro-post-header {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  min-width: 0;
}

.alumni-pro-avatar {
  width: 43px;
  height: 43px;
  font-size: 13px;
}

.alumni-pro-author {
  min-width: 0;
  flex: 1 1 auto;
  padding-top: 2px;
}

.alumni-pro-author > div {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 6px;
}

.alumni-pro-author a {
  overflow: hidden;
  color: var(--app-text);
  font-size: 14px;
  font-weight: 840;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.alumni-pro-author > div > span,
.alumni-pro-author time {
  color: var(--app-muted-2);
  font-size: 12px;
  white-space: nowrap;
}

.alumni-pro-author > p {
  overflow: hidden;
  margin-top: 2px;
  color: var(--app-muted-2);
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.alumni-pro-caption-wrap {
  position: relative;
  margin: 12px 0 10px;
}

.alumni-pro-caption {
  margin: 0;
  white-space: pre-wrap;
  color: var(--app-text-soft);
  font-size: 15px;
  line-height: 1.55;
  letter-spacing: -.008em;
}

.alumni-pro-caption.is-clamped {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
}

.alumni-pro-caption-more {
  margin-top: 3px;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--app-muted);
  font-size: 13px;
  font-weight: 780;
}

.alumni-pro-repeated-links {
  display: block;
  margin-top: 5px;
  color: var(--app-muted-3);
  font-size: 12px;
}

/* ---------------------------------------------------------
   Link preview
   --------------------------------------------------------- */
.alumni-link-preview {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  overflow: hidden;
  margin: 10px 0 12px;
  border: 1px solid var(--app-border);
  border-radius: 14px;
  background: var(--app-soft);
  color: inherit;
}

.alumni-link-preview:hover {
  background: var(--app-soft-strong);
}

.alumni-link-preview-image {
  width: 100%;
  max-height: 250px;
  object-fit: cover;
}

.alumni-link-preview-copy {
  min-width: 0;
  padding: 11px 13px 12px;
}

.alumni-link-preview-domain {
  display: block;
  margin-bottom: 3px;
  color: var(--app-muted-2);
  font-size: 11px;
  font-weight: 760;
  text-transform: uppercase;
  letter-spacing: .08em;
}

.alumni-link-preview-copy strong {
  display: block;
  overflow: hidden;
  color: var(--app-text);
  font-size: 14px;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.alumni-link-preview-copy p {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 4px;
  color: var(--app-muted);
  font-size: 13px;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.alumni-link-preview-external {
  position: absolute;
  top: 12px;
  right: 12px;
  color: var(--app-muted-2);
}

.alumni-link-preview-loading {
  min-height: 84px;
  padding: 14px;
}

.alumni-link-preview-loading div {
  height: 10px;
  margin-bottom: 8px;
  border-radius: 999px;
  background: var(--app-soft-strong);
  animation: alumni-link-pulse 1.2s ease-in-out infinite;
}

.alumni-link-preview-loading div:last-child {
  width: 65%;
}

@keyframes alumni-link-pulse {
  50% {
    opacity: .45;
  }
}

/* ---------------------------------------------------------
   Media carousel / video
   --------------------------------------------------------- */
.alumni-pro-media-shell {
  position: relative;
  margin: 2px -16px 0;
  overflow: visible;
  background: #05070b;
}

.alumni-pro-carousel {
  display: flex;
  overflow-x: auto;
  overflow-y: hidden;
  scroll-behavior: smooth;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
}

.alumni-pro-carousel::-webkit-scrollbar {
  display: none;
}

.alumni-pro-media-slide {
  position: relative;
  flex: 0 0 100%;
  width: 100%;
  scroll-snap-align: center;
  scroll-snap-stop: always;
}

.alumni-pro-image-button {
  display: block;
  width: 100%;
  padding: 0;
  border: 0;
  background: #05070b;
}

.alumni-pro-image-button img,
.alumni-feed-video {
  display: block;
  width: 100%;
  max-height: 760px;
  object-fit: contain;
  background: #05070b;
}

.alumni-feed-video-wrap {
  position: relative;
  width: 100%;
}

.alumni-feed-video {
  min-height: 240px;
}

.alumni-feed-video-mute {
  position: absolute;
  right: 12px;
  bottom: 12px;
  display: inline-flex;
  width: 34px;
  height: 34px;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 999px;
  background: rgba(5, 7, 11, .62);
  color: white;
  backdrop-filter: blur(10px);
}

.alumni-pro-media-menu {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 24;
}

.alumni-pro-carousel-count {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 20;
  min-width: 40px;
  padding: 5px 9px;
  border-radius: 999px;
  background: rgba(5, 7, 11, .62);
  color: white;
  font-size: 10px;
  font-weight: 800;
  text-align: center;
  backdrop-filter: blur(10px);
}

.alumni-pro-carousel-dots {
  position: absolute;
  right: 0;
  bottom: 11px;
  left: 0;
  z-index: 20;
  display: flex;
  justify-content: center;
  gap: 5px;
  pointer-events: none;
}

.alumni-pro-carousel-dots button {
  width: 5px;
  height: 5px;
  padding: 0;
  border: 0;
  border-radius: 999px;
  background: rgba(255,255,255,.45);
  pointer-events: auto;
}

.alumni-pro-carousel-dots button.is-active {
  width: 14px;
  background: white;
}

.alumni-pro-carousel-arrow {
  position: absolute;
  top: 50%;
  z-index: 20;
  display: inline-flex;
  width: 34px;
  height: 34px;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 999px;
  background: rgba(5, 7, 11, .56);
  color: white;
  transform: translateY(-50%);
  backdrop-filter: blur(10px);
}

.alumni-pro-carousel-arrow.is-left {
  left: 10px;
}

.alumni-pro-carousel-arrow.is-right {
  right: 10px;
}

.alumni-pro-carousel-arrow:disabled {
  opacity: 0;
  pointer-events: none;
}

.alumni-pro-heart-burst {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 26;
  color: white;
  pointer-events: none;
  transform: translate(-50%, -50%);
  animation: alumni-heart-burst .72s cubic-bezier(.2,.9,.2,1);
}

.alumni-pro-heart-burst svg {
  width: 92px;
  height: 92px;
  filter: drop-shadow(0 8px 22px rgba(0,0,0,.35));
}

@keyframes alumni-heart-burst {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(.35);
  }
  35% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.1);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(.88);
  }
}

/* ---------------------------------------------------------
   Menu on media / text post
   --------------------------------------------------------- */
.alumni-pro-post-menu-zone {
  position: relative;
  z-index: 30;
  flex: 0 0 auto;
}

.alumni-pro-menu-trigger {
  display: inline-flex;
  width: 36px;
  height: 36px;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: var(--app-muted);
}

.alumni-pro-media-menu .alumni-pro-menu-trigger {
  background: rgba(5, 7, 11, .58);
  color: white;
  backdrop-filter: blur(12px);
}

.alumni-pro-menu-trigger:hover {
  background: var(--app-soft);
  color: var(--app-text);
}

.alumni-pro-menu-popover {
  position: absolute;
  top: 42px;
  right: 0;
  z-index: 70;
  width: 220px;
  overflow: hidden;
  border: 1px solid var(--app-border);
  border-radius: 15px;
  background: color-mix(in srgb, var(--app-surface) 97%, transparent);
  box-shadow: 0 16px 42px rgba(0,0,0,.24);
  backdrop-filter: blur(18px);
  animation: alumni-menu-in .14s ease-out;
}

.alumni-pro-menu-popover > button {
  display: flex;
  width: 100%;
  min-height: 45px;
  align-items: center;
  gap: 10px;
  padding: 0 13px;
  border: 0;
  border-bottom: 1px solid var(--app-border);
  background: transparent;
  color: var(--app-text-soft);
  font-size: 13px;
  font-weight: 760;
  text-align: left;
}

.alumni-pro-menu-popover > button:last-child {
  border-bottom: 0;
}

.alumni-pro-menu-popover > button:hover {
  background: var(--app-soft);
}

.alumni-pro-menu-popover > button[data-danger="true"] {
  color: #ef6b75;
}

@keyframes alumni-menu-in {
  from {
    opacity: 0;
    transform: translateY(-4px) scale(.985);
  }
}

/* ---------------------------------------------------------
   Action row / stats
   --------------------------------------------------------- */
.alumni-feed-page .alumni-pro-actions,
.alumni-feed-page .alumni-post-actions {
  display: flex !important;
  grid-template-columns: none !important;
  flex-wrap: nowrap !important;
}

.alumni-pro-actions {
  align-items: center;
  gap: 7px;
  min-height: 45px;
  margin-top: 1px;
  padding: 1px 0 0;
}

.alumni-pro-actions > button {
  display: inline-flex;
  width: 40px !important;
  min-width: 40px !important;
  max-width: 40px !important;
  height: 40px !important;
  flex: 0 0 40px !important;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  padding: 0 !important;
  border: 0;
  border-radius: 999px;
  background: transparent !important;
  color: var(--app-muted);
  box-shadow: none !important;
  transition:
    color .15s ease,
    background-color .15s ease,
    transform .12s ease;
}

.alumni-pro-actions > button:hover {
  background: var(--app-soft) !important;
  color: var(--app-text);
}

.alumni-pro-actions > button:active {
  transform: scale(.9);
}

.alumni-pro-actions > button.is-like[data-active="true"] {
  color: #f05b72 !important;
}

.alumni-pro-actions > button.is-repost[data-active="true"] {
  color: #35b97f !important;
}

.alumni-pro-actions > button.is-repost svg {
  width: 25px !important;
  height: 25px !important;
}

.alumni-pro-actions > button:disabled {
  cursor: default;
  opacity: .35;
}

.alumni-pro-stats {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 20px;
  color: var(--app-muted-2);
  font-size: 12px;
}

.alumni-pro-stats > span {
  flex: 1 1 auto;
}

.alumni-pro-stats button {
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
}

.alumni-pro-stats button:hover {
  color: var(--app-text-soft);
}

.alumni-pro-stats strong {
  color: var(--app-text-soft);
  font-weight: 800;
}

.alumni-pro-comment-preview {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: baseline;
  gap: 6px;
  margin-top: 6px;
  padding: 0;
  border: 0;
  background: transparent;
  text-align: left;
}

.alumni-pro-comment-preview strong {
  flex: 0 0 auto;
  color: var(--app-text-soft);
  font-size: 12px;
}

.alumni-pro-comment-preview span {
  overflow: hidden;
  color: var(--app-muted);
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.alumni-pro-view-comments {
  margin-top: 4px;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--app-muted-2);
  font-size: 12px;
}

/* ---------------------------------------------------------
   Comment sheet + engagement modal
   --------------------------------------------------------- */
.alumni-comments-backdrop,
.alumni-feed-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 2147482500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18px;
  background: rgba(0,0,0,.5);
  backdrop-filter: blur(5px);
}

.alumni-comments-sheet,
.alumni-feed-people-modal {
  display: flex;
  width: min(560px, 100%);
  max-height: min(720px, 84dvh);
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--app-border);
  border-radius: 22px;
  background: var(--app-surface);
  box-shadow: 0 30px 80px rgba(0,0,0,.32);
  animation: alumni-sheet-in .18s ease-out;
}

.alumni-comments-header,
.alumni-feed-people-modal > header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 15px 17px;
  border-bottom: 1px solid var(--app-border);
}

.alumni-comments-header span,
.alumni-feed-people-modal > header span {
  display: block;
  color: var(--app-muted-3);
  font-size: 10px;
  font-weight: 850;
  text-transform: uppercase;
  letter-spacing: .12em;
}

.alumni-comments-header h3,
.alumni-feed-people-modal > header h3 {
  margin-top: 2px;
  color: var(--app-text);
  font-size: 16px;
  font-weight: 900;
}

.alumni-comments-header > button,
.alumni-feed-people-modal > header > button {
  display: inline-flex;
  width: 38px;
  height: 38px;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: var(--app-muted);
}

.alumni-comments-list,
.alumni-feed-people-list {
  min-height: 0;
  flex: 1 1 auto;
  overflow-y: auto;
  padding: 10px 16px 14px;
}

.alumni-feed-comment {
  display: flex;
  gap: 10px;
  padding: 10px 0;
}

.alumni-feed-comment.is-focused {
  border-radius: 12px;
  background: var(--app-accent-soft);
}

.alumni-feed-comment-avatar,
.alumni-feed-person-avatar {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 999px;
  background: var(--app-surface-2);
  color: var(--app-text);
  font-size: 11px;
  font-weight: 800;
}

.alumni-feed-comment-avatar {
  width: 34px;
  height: 34px;
}

.alumni-feed-comment-avatar img,
.alumni-feed-person-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.alumni-feed-comment-body {
  min-width: 0;
  flex: 1 1 auto;
}

.alumni-feed-comment-body > p {
  color: var(--app-text-soft);
  font-size: 14px;
  line-height: 1.55;
}

.alumni-feed-comment-body > p a {
  margin-right: 6px;
  color: var(--app-text);
  font-weight: 820;
}

.alumni-comments-composer {
  display: flex;
  gap: 8px;
  padding: 12px 14px calc(12px + env(safe-area-inset-bottom));
  border-top: 1px solid var(--app-border);
  background: var(--app-surface);
}

.alumni-comments-composer input {
  min-width: 0;
  height: 42px;
  flex: 1 1 auto;
  padding: 0 13px;
  border: 1px solid var(--app-border);
  border-radius: 14px;
  outline: 0;
  background: var(--app-soft);
  color: var(--app-text);
  font-size: 12px;
}

.alumni-comments-composer > button {
  display: inline-flex;
  width: 42px;
  height: 42px;
  flex: 0 0 42px;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 14px;
  background: var(--app-accent-fill);
  color: var(--app-on-accent);
}

.alumni-comments-composer > button:disabled {
  opacity: .35;
}

.alumni-feed-person {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 9px 0;
}

.alumni-feed-person-avatar {
  width: 40px;
  height: 40px;
}

.alumni-feed-person-copy {
  min-width: 0;
}

.alumni-feed-person-copy strong,
.alumni-feed-person-copy small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.alumni-feed-person-copy strong {
  color: var(--app-text);
  font-size: 12px;
}

.alumni-feed-person-copy small {
  margin-top: 2px;
  color: var(--app-muted);
  font-size: 10px;
}

.alumni-feed-modal-empty {
  padding: 26px 8px;
  color: var(--app-muted-2);
  font-size: 12px;
  text-align: center;
}

@keyframes alumni-sheet-in {
  from {
    opacity: 0;
    transform: translateY(8px) scale(.99);
  }
}

/* ---------------------------------------------------------
   Full-screen media viewer / toast
   --------------------------------------------------------- */
.alumni-pro-media-viewer {
  position: fixed;
  inset: 0;
  z-index: 2147483000;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: auto;
  padding: 0;
  background: #050506;
}

.alumni-pro-media-viewer > button {
  position: fixed;
  top: max(14px, env(safe-area-inset-top));
  right: 14px;
  z-index: 10;
  display: inline-flex;
  width: 40px;
  height: 40px;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 999px;
  background: rgba(255,255,255,.1);
  color: white;
  backdrop-filter: blur(10px);
}

.alumni-pro-media-viewer img {
  display: block;
  width: auto;
  max-width: 100vw;
  height: auto;
  max-height: none;
  margin: auto;
  object-fit: contain;
}

.alumni-pro-media-viewer video {
  width: min(100vw, 1100px);
  max-height: 100dvh;
  background: black;
}

.alumni-pro-toast {
  position: fixed;
  left: 50%;
  bottom: calc(88px + env(safe-area-inset-bottom));
  z-index: 2147483200;
  max-width: min(88vw, 420px);
  padding: 9px 13px;
  border: 1px solid var(--app-border);
  border-radius: 999px;
  background: color-mix(in srgb, var(--app-surface) 94%, transparent);
  color: var(--app-text-soft);
  box-shadow: 0 10px 30px rgba(0,0,0,.22);
  font-size: 11px;
  font-weight: 720;
  transform: translateX(-50%);
  backdrop-filter: blur(14px);
  animation: alumni-toast-in .16s ease-out;
}

@keyframes alumni-toast-in {
  from {
    opacity: 0;
    transform: translate(-50%, 6px);
  }
}

/* ---------------------------------------------------------
   Mobile
   --------------------------------------------------------- */
@media (max-width: 639px) {
  .alumni-pro-composer {
    margin-right: -4px;
    margin-left: -4px;
  }

  .alumni-pro-composer-limit {
    display: none;
  }

  .alumni-pro-composer-submit > button:not(.is-primary) {
    padding-inline: 8px;
  }

  .alumni-pro-post {
    padding-top: 15px;
    padding-bottom: 18px;
  }

  .alumni-pro-media-shell {
    margin-right: -16px;
    margin-left: -16px;
  }

  .alumni-pro-image-button img,
  .alumni-feed-video {
    width: 100%;
    max-height: none;
    object-fit: cover;
  }

  .alumni-pro-actions {
    gap: 4px;
    min-height: 44px;
  }

  .alumni-pro-actions > button {
    width: 41px !important;
    min-width: 41px !important;
    max-width: 41px !important;
    height: 41px !important;
    flex-basis: 41px !important;
  }

  .alumni-pro-carousel-arrow {
    display: none;
  }

  .alumni-comments-backdrop {
    align-items: flex-end;
    padding: 0;
  }

  .alumni-comments-sheet {
    width: 100%;
    max-height: 82dvh;
    border-right: 0;
    border-bottom: 0;
    border-left: 0;
    border-radius: 22px 22px 0 0;
  }

  .alumni-feed-modal-backdrop {
    padding: 12px;
  }

  .alumni-feed-people-modal {
    max-height: 74dvh;
  }

  .alumni-pro-media-viewer img {
    width: 100vw;
    max-width: 100vw;
  }
}

/* ---------------------------------------------------------
   Legacy feed neutralization
   --------------------------------------------------------- */
.alumni-feed-page .alumni-composer,
.alumni-feed-page .alumni-post-card,
.alumni-feed-page .alumni-post-media,
.alumni-feed-page .alumni-post-media img,
.alumni-feed-page .alumni-post-footer {
  box-shadow: none !important;
}

.alumni-feed-page .alumni-post-media {
  padding: 0 !important;
}

/* ALUMNI_1_4_0_FEED_PRO_CSS */

/* ALUMNI 1.4.1 — legibilidad final */
.alumni-feed-pro .alumni-pro-repost-label {
  font-size: 12px !important;
}

.alumni-feed-pro .alumni-pro-author a {
  font-size: 14px !important;
}

.alumni-feed-pro .alumni-pro-author time,
.alumni-feed-pro .alumni-pro-author > div > span,
.alumni-feed-pro .alumni-pro-author > p {
  font-size: 12px !important;
}

.alumni-feed-pro .alumni-pro-stats,
.alumni-feed-pro .alumni-pro-comment-preview strong,
.alumni-feed-pro .alumni-pro-comment-preview span,
.alumni-feed-pro .alumni-pro-view-comments {
  font-size: 12px !important;
}

.alumni-feed-pro .alumni-feed-comment-body > p {
  font-size: 14px !important;
  line-height: 1.55 !important;
}

.alumni-feed-pro .alumni-pro-menu-popover > button {
  font-size: 13px !important;
}

/*
 * El botón ... sigue SOBRE la imagen arriba-derecha,
 * pero el popover puede salir del rectángulo si la imagen es baja.
 */
.alumni-feed-pro .alumni-pro-media-shell {
  overflow: visible !important;
}

.alumni-feed-pro .alumni-pro-carousel {
  overflow-x: auto !important;
  overflow-y: hidden !important;
}

.alumni-feed-pro .alumni-pro-media-menu {
  top: 10px !important;
  right: 10px !important;
  left: auto !important;
  bottom: auto !important;
}

.alumni-feed-pro .alumni-pro-menu-popover {
  max-height: min(360px, 70dvh);
  overflow-y: auto;
}

@media (max-width: 639px) {
  .alumni-feed-pro .alumni-pro-author a {
    font-size: 14px !important;
  }

  .alumni-feed-pro .alumni-pro-author time,
  .alumni-feed-pro .alumni-pro-author > p {
    font-size: 12px !important;
  }
}

/* ALUMNI_1_4_1_PROFILE_REPOSTS_SAVED_READABILITY:FEED_CSS */

/* ALUMNI_PERFORMANCE_HARDENING_FEED_CONTENT_VISIBILITY_V5 */
