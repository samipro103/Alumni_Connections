.alumni-more-clean {
  --more-clean-wash:
    color-mix(
      in srgb,
      var(--app-accent) 9%,
      transparent
    );
  padding-bottom:
    28px;
}

.alumni-more-clean-header {
  display: flex;
  min-height: 54px;
  align-items: center;
  padding: 0 2px;
}

.alumni-more-clean-header h1 {
  margin: 0;
  color: var(--app-text);
  font-size: 30px;
  line-height: 1;
  font-weight: 950;
  letter-spacing: -.05em;
}

.alumni-more-clean-featured {
  display: grid;
  grid-template-columns:
    repeat(
      2,
      minmax(0,1fr)
    );
  gap: 10px;
  margin-top: 12px;
}

.alumni-more-clean-card {
  display: grid;
  min-height: 116px;
  grid-template-columns:
    minmax(0,1fr)
    18px;
  grid-template-rows:
    1fr auto;
  align-items: center;
  gap: 8px;
  padding: 16px;
  border:
    1px solid
    var(--app-border);
  border-radius: 20px;
  background:
    var(--app-surface);
  color:
    var(--app-text);
  text-decoration: none;
}

.alumni-more-clean-card-icon {
  display: inline-flex;
  width: 42px;
  height: 42px;
  align-items: center;
  justify-content: center;
  border-radius: 13px;
  background:
    var(--more-clean-wash);
  color:
    var(--app-accent);
}

.alumni-more-clean-card
strong {
  align-self: end;
  font-size: 13px;
  font-weight: 900;
  letter-spacing: -.02em;
}

.alumni-more-clean-card
> svg {
  align-self: end;
  color:
    var(--app-muted-3);
}

.alumni-more-clean-settings {
  margin-top: 30px;
}

.alumni-more-clean-settings h2 {
  margin:
    0 0 10px
    2px;
  color:
    var(--app-text);
  font-size: 16px;
  font-weight: 900;
  letter-spacing: -.025em;
}

.alumni-more-clean-list {
  overflow: hidden;
  border:
    1px solid
    var(--app-border);
  border-radius: 18px;
  background:
    var(--app-surface);
}

.alumni-more-clean-row {
  display: grid;
  grid-template-columns:
    36px
    minmax(0,1fr)
    18px;
  align-items: center;
  gap: 11px;
  min-height: 60px;
  padding:
    8px 14px;
  border-top:
    1px solid
    var(--app-border);
  color:
    inherit;
  text-decoration: none;
}

.alumni-more-clean-list
> div:first-child
.alumni-more-clean-row {
  border-top: 0;
}

.alumni-more-clean-row:active {
  background:
    var(--app-soft);
}

.alumni-more-clean-row-icon {
  display: inline-flex;
  width: 34px;
  height: 34px;
  align-items: center;
  justify-content: center;
  border-radius: 11px;
  background:
    var(--app-soft);
  color:
    var(--app-accent);
}

.alumni-more-clean-row
strong {
  overflow: hidden;
  color:
    var(--app-text);
  font-size: 11.5px;
  font-weight: 830;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.alumni-more-clean-row
> svg {
  color:
    var(--app-muted-3);
}

@media (max-width: 390px) {
  .alumni-more-clean-card {
    min-height: 108px;
    padding: 14px;
  }

  .alumni-more-clean-row {
    min-height: 58px;
    padding:
      8px 12px;
  }
}

/* ALUMNI_MORE_CLEAN_2_1 */
