.alumni-more-clean {
  --more-clean-wash:
    color-mix(
      in srgb,
      var(--app-accent) 9%,
      transparent
    );
  width: 100%;
  padding-bottom: 28px;
}

.alumni-more-clean-header {
  display: flex;
  min-height: 58px;
  align-items: center;
  padding: 2px 2px 4px;
}

.alumni-more-clean-header h1 {
  margin: 0;
  color: var(--app-text);
  font-size:
    clamp(
      26px,
      7.5vw,
      34px
    );
  line-height: 1.04;
  font-weight: 950;
  letter-spacing: -.045em;
}

.alumni-more-clean-featured {
  display: grid;
  grid-template-columns:
    repeat(
      2,
      minmax(0, 1fr)
    );
  gap: 10px;
  margin-top: 10px;
}

.alumni-more-clean-featured
> div {
  min-width: 0;
}

.alumni-more-clean-card {
  display: grid;
  width: 100%;
  min-height: 106px;
  grid-template-columns:
    minmax(0, 1fr)
    18px;
  grid-template-rows:
    1fr auto;
  align-items: center;
  gap: 8px;
  padding: 15px;
  border:
    1px solid
    var(--app-border);
  border-radius: 19px;
  background:
    var(--app-surface);
  color:
    var(--app-text);
  text-decoration: none;
  transition:
    background-color 160ms ease,
    border-color 160ms ease;
}

.alumni-more-clean-card:active {
  background:
    var(--app-soft);
}

.alumni-more-clean-card-icon {
  display: inline-flex;
  width: 40px;
  height: 40px;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background:
    var(--more-clean-wash);
  color:
    var(--app-accent);
}

.alumni-more-clean-card
strong {
  align-self: end;
  font-size: 12.5px;
  font-weight: 900;
  letter-spacing: -.02em;
}

.alumni-more-clean-card
> svg {
  align-self: end;
  color:
    var(--app-muted-3);
}

.alumni-more-clean-settings {
  margin-top: 28px;
}

.alumni-more-clean-settings h2 {
  margin:
    0 0 9px
    2px;
  color:
    var(--app-text);
  font-size: 15px;
  font-weight: 900;
  letter-spacing: -.025em;
}

.alumni-more-clean-list {
  overflow: hidden;
  border:
    1px solid
    var(--app-border);
  border-radius: 18px;
  background:
    var(--app-surface);
}

.alumni-more-clean-row {
  display: grid;
  grid-template-columns:
    36px
    minmax(0, 1fr)
    18px;
  align-items: center;
  gap: 11px;
  min-height: 58px;
  padding: 8px 13px;
  border-top:
    1px solid
    var(--app-border);
  color: inherit;
  text-decoration: none;
  transition:
    background-color 150ms ease;
}

.alumni-more-clean-row:first-child {
  border-top: 0;
}

.alumni-more-clean-row:active {
  background:
    var(--app-soft);
}

.alumni-more-clean-row-icon {
  display: inline-flex;
  width: 34px;
  height: 34px;
  align-items: center;
  justify-content: center;
  border-radius: 11px;
  background:
    var(--app-soft);
  color:
    var(--app-text-soft);
}

.alumni-more-clean-row:nth-last-child(2)
.alumni-more-clean-row-icon {
  background:
    color-mix(
      in srgb,
      var(--app-accent) 10%,
      transparent
    );
  color:
    var(--app-accent);
}

.alumni-more-clean-row:last-child
.alumni-more-clean-row-icon {
  background:
    var(--app-soft-strong);
  color:
    var(--app-muted);
}

.alumni-more-clean-row
strong {
  overflow: hidden;
  color:
    var(--app-text);
  font-size: 11.5px;
  font-weight: 830;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.alumni-more-clean-row
> svg {
  color:
    var(--app-muted-3);
}

@media (max-width: 390px) {
  .alumni-more-clean-card {
    min-height: 100px;
    padding: 13px;
  }

  .alumni-more-clean-row {
    min-height: 56px;
    padding:
      7px 12px;
  }
}

/* ALUMNI_STABILITY_PASS_1_0 */

/* =========================================================
   ALUMNI More — Eventos / Comunidades alignment fix 1.0
   ========================================================= */

.alumni-more-clean-featured {
  display: grid;
  grid-template-columns:
    repeat(
      2,
      minmax(0, 1fr)
    );
  gap: 10px;
  width: 100%;
  margin-top: 10px;
}

.alumni-more-clean-featured
> div {
  min-width: 0;
  width: 100%;
  height: 100%;
}

.alumni-more-clean-card {
  display: grid !important;
  width: 100% !important;
  min-width: 0;
  min-height: 104px !important;
  height: 100%;
  grid-template-columns:
    minmax(0, 1fr)
    18px !important;
  grid-template-rows:
    42px
    minmax(0, 1fr) !important;
  align-items: center;
  gap: 8px;
  padding:
    13px 14px !important;
  overflow: hidden;
}

.alumni-more-clean-card-icon {
  align-self: start;
  width: 40px;
  height: 40px;
  flex: 0 0 40px;
}

.alumni-more-clean-card
strong {
  display: block;
  min-width: 0;
  max-width: 100%;
  align-self: end;
  overflow: hidden;
  color:
    var(--app-text);
  font-size: 12px !important;
  font-weight: 900;
  line-height: 1.15;
  letter-spacing: -.02em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.alumni-more-clean-card
> svg {
  align-self: end;
  justify-self: end;
  flex: 0 0 auto;
}

@media (max-width: 370px) {
  .alumni-more-clean-featured {
    gap: 8px;
  }

  .alumni-more-clean-card {
    min-height:
      98px !important;
    padding:
      12px !important;
  }

  .alumni-more-clean-card
  strong {
    font-size:
      11.5px !important;
  }
}

/* ALUMNI_MORE_EVENTS_COMMUNITIES_FIX_1_0 */
