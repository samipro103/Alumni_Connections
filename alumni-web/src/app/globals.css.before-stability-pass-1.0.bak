  border-radius:
    22px;
  background:
    var(--app-surface);
}

.alumni-notifications-pro
.alumni-notifications-header h1 {
  font-weight: 950;
  letter-spacing:
    -.045em;
}

/* ---------------------------------------------------------
   More — grouped + developer-style clarity
   --------------------------------------------------------- */

.alumni-more-vp {
  --more-wash:
    color-mix(
      in srgb,
      var(--app-accent) 10%,
      transparent
    );
  --more-line:
    color-mix(
      in srgb,
      var(--app-accent) 28%,
      var(--app-border)
    );
  padding-bottom:
    30px;
}

.alumni-more-vp-hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  padding:
    28px 21px
    24px;
  border:
    1px solid
    var(--app-border);
  border-radius:
    26px;
  background:
    var(--app-surface);
}

.alumni-more-vp-hero::before {
  content: "";
  position: absolute;
  z-index: -2;
  top: -104px;
  right: -105px;
  width: 220px;
  height: 220px;
  border:
    1px solid
    var(--more-line);
  border-radius: 50%;
}

.alumni-more-vp-orbit {
  position: absolute;
  z-index: -1;
  border:
    1px solid
    var(--app-border);
  border-radius: 50%;
  opacity: .68;
}

.alumni-more-vp-orbit::after {
  content: "";
  position: absolute;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background:
    var(--app-accent);
  box-shadow:
    0 0 0 5px
    var(--more-wash);
}

.alumni-more-vp-orbit.is-one {
  left: -62px;
  bottom: 16px;
  width: 108px;
  height: 108px;
}

.alumni-more-vp-orbit.is-one::after {
  top: 14px;
  right: 9px;
}

.alumni-more-vp-orbit.is-two {
  right: 12px;
  bottom: -42px;
  width: 78px;
  height: 78px;
}

.alumni-more-vp-orbit.is-two::after {
  top: 9px;
  left: 8px;
}

.alumni-more-vp-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 27px;
  padding: 0 10px;
  border:
    1px solid
    var(--more-line);
  border-radius: 999px;
  background:
    var(--more-wash);
  color:
    var(--app-accent);
  font-size: 9px;
  font-weight: 900;
  letter-spacing:
    .12em;
  text-transform:
    uppercase;
}

.alumni-more-vp-hero h1 {
  margin:
    22px 0 0;
  font-size:
    clamp(
      34px,
      9vw,
      46px
    );
  line-height: 1;
  font-weight: 950;
  letter-spacing:
    -.055em;
}

.alumni-more-vp-hero p {
  max-width: 500px;
  margin:
    12px 0 0;
  color:
    var(--app-text-soft);
  font-size: 12px;
  line-height: 1.7;
}

.alumni-more-vp-profile {
  display: grid;
  grid-template-columns:
    58px
    minmax(0,1fr)
    20px;
  align-items: center;
  gap: 13px;
  margin-top: 13px;
  padding:
    14px;
  border:
    1px solid
    var(--more-line);
  border-radius:
    20px;
  background:
    var(--more-wash);
  color: inherit;
  text-decoration: none;
}

.alumni-more-vp-avatar {
  width: 56px;
  height: 56px;
  overflow: hidden;
  border:
    2px solid
    var(--app-bg);
  border-radius: 50%;
  background:
    var(--app-surface-2);
}

.alumni-more-vp-profile-copy {
  display: flex;
  min-width: 0;
  flex-direction:
    column;
}

.alumni-more-vp-profile-copy
small {
  color:
    var(--app-accent);
  font-size: 8px;
  font-weight: 900;
  letter-spacing:
    .12em;
}

.alumni-more-vp-profile-copy
strong {
  overflow: hidden;
  margin-top: 4px;
  font-size: 14px;
  font-weight: 900;
  text-overflow:
    ellipsis;
  white-space:
    nowrap;
}

.alumni-more-vp-profile-copy
span {
  overflow: hidden;
  margin-top: 3px;
  color:
    var(--app-muted);
  font-size: 9.5px;
  text-overflow:
    ellipsis;
  white-space:
    nowrap;
}

.alumni-more-vp-section {
  margin-top: 34px;
}

.alumni-more-vp-section-head {
  padding:
    0 3px
    12px;
}

.alumni-more-vp-section-head
small {
  color:
    var(--app-accent);
  font-size: 8.5px;
  font-weight: 900;
  letter-spacing:
    .14em;
}

.alumni-more-vp-section-head h2 {
  margin:
    6px 0 0;
  font-size:
    23px;
  line-height: 1.05;
  font-weight: 930;
  letter-spacing:
    -.04em;
}

.alumni-more-vp-section-head p {
  max-width: 520px;
  margin:
    7px 0 0;
  color:
    var(--app-muted);
  font-size: 10.5px;
  line-height: 1.6;
}

.alumni-more-vp-list {
  overflow: hidden;
  border:
    1px solid
    var(--app-border);
  border-radius:
    20px;
  background:
    var(--app-surface);
}

.alumni-more-vp-row {
  display: grid;
  grid-template-columns:
    39px
    minmax(0,1fr)
    18px;
  align-items: center;
  gap: 12px;
  min-height: 72px;
  padding:
    11px 14px;
  border-top:
    1px solid
    var(--app-border);
  color: inherit;
  text-decoration: none;
}

.alumni-more-vp-row:first-child {
  border-top: 0;
}

.alumni-more-vp-row:active {
  background:
    var(--app-soft);
}

.alumni-more-vp-row-icon {
  display: inline-flex;
  width: 38px;
  height: 38px;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background:
    var(--more-wash);
  color:
    var(--app-accent);
}

.alumni-more-vp-row-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 3px;
}

.alumni-more-vp-row-copy
strong {
  font-size: 12px;
  font-weight: 880;
}

.alumni-more-vp-row-copy
small {
  color:
    var(--app-muted);
  font-size: 9.5px;
  line-height: 1.45;
}

.alumni-more-vp-chevron {
  color:
    var(--app-muted-3);
}

.alumni-more-vp-logout {
  display: grid;
  width: 100%;
  grid-template-columns:
    30px
    minmax(0,1fr);
  align-items: center;
  gap: 10px;
  margin-top: 26px;
  padding:
    13px 4px;
  border: 0;
  border-top:
    1px solid
    var(--app-border);
  border-bottom:
    1px solid
    var(--app-border);
  background:
    transparent;
  color:
    var(--app-danger);
  text-align: left;
}

.alumni-more-vp-logout
> span {
  display: flex;
  flex-direction:
    column;
  gap: 2px;
}

.alumni-more-vp-logout
strong {
  font-size: 11px;
  font-weight: 850;
}

.alumni-more-vp-logout
small {
  color:
    var(--app-muted);
  font-size: 9px;
}

/* ---------------------------------------------------------
   Mobile refinements
   --------------------------------------------------------- */

@media (max-width: 480px) {
  :is(
    .events2-hero,
    .community2-hero,
    .alumni-explore-pro
      .alumni-explore-hero,
    .alumni-messages-page
      .alumni-inbox-header,
    .alumni-notifications-pro
      .alumni-notifications-header
  ) {
    border-radius:
      20px;
  }

  .alumni-more-vp-hero {
    padding:
      25px 18px
      22px;
    border-radius:
      22px;
  }

  .alumni-more-vp-profile {
    border-radius:
      18px;
  }

  .alumni-more-vp-list {
    border-radius:
      18px;
  }
}

