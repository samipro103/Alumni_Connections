  border-radius:
    17px;
  background:
    var(--app-surface);
}

:is(
  .events2-list,
  .community2-list
) {
  overflow: hidden;
  margin-top: 14px;
  border:
    1px solid
    var(--app-border);
  border-radius:
    21px;
  background:
    var(--app-surface);
}

:is(
  .events2-row,
  .community2-row
) {
  padding-right:
    15px;
  padding-left:
    15px;
}

:is(
  .events2-primary-action,
  .community2-primary-action
) {
  border-radius:
    13px !important;
  box-shadow:
    0 9px 24px
    color-mix(
      in srgb,
      var(--app-accent) 12%,
      transparent
    );
}

/* ---------------------------------------------------------
   Notifications
   --------------------------------------------------------- */

.alumni-notifications-pro
