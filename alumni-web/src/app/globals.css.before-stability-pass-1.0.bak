@import "tailwindcss";

:root,
html[data-theme="dark"] {
  --app-bg: #090b0f;
  --app-bg-2: #0c0f15;
  --app-surface: #101318;
  --app-surface-2: #191e27;
  --app-soft: rgba(255,255,255,.035);
  --app-soft-strong: rgba(255,255,255,.065);
  --app-border: rgba(255,255,255,.075);
  --app-text: #f4f4f5;
  --app-text-soft: #d4d4d8;
  --app-muted: #8b93a1;
  --app-muted-2: #606875;
  --app-muted-3: #414852;
  --app-accent: #7f8cff;
  --app-accent-2: #6d7cff;
  --app-accent-fill: #6d7cff;
  --app-accent-soft: rgba(109,124,255,.12);
  --app-on-accent: #ffffff;
  --app-topbar: rgba(9,11,15,.91);
  --app-glow-1: rgba(91,111,255,.11);
  --app-glow-2: rgba(124,58,237,.07);
  --app-shadow: rgba(0,0,0,.28);
}

html[data-theme="light"] {
  --app-bg: #f4f6fa;
  --app-bg-2: #eef1f6;
  --app-surface: #ffffff;
  --app-surface-2: #edf1f7;
  --app-soft: rgba(15,23,42,.035);
  --app-soft-strong: rgba(15,23,42,.065);
  --app-border: rgba(15,23,42,.09);
  --app-text: #10141b;
  --app-text-soft: #27303c;
  --app-muted: #637083;
  --app-muted-2: #7c8796;
  --app-muted-3: #a4acb7;
  --app-accent: #5267e8;
  --app-accent-2: #5267e8;
  --app-accent-fill: #5267e8;
  --app-accent-soft: rgba(82,103,232,.10);
  --app-on-accent: #ffffff;
  --app-topbar: rgba(255,255,255,.90);
  --app-glow-1: rgba(82,103,232,.08);
  --app-glow-2: rgba(88,129,255,.06);
  --app-shadow: rgba(31,41,55,.08);
}






@theme inline {
  --color-background: var(--app-bg);
  --color-foreground: var(--app-text);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

* {
  box-sizing: border-box;
}

html {
  background: var(--app-bg);
}

body {
  margin: 0;
  color: var(--app-text);
  background: var(--app-bg);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  transition:
    background-color .18s ease,
    color .18s ease;
}

::selection {
  background: color-mix(in srgb, var(--app-accent) 34%, transparent);
  color: var(--app-text);
}

button,
a,
input,
textarea {
  -webkit-tap-highlight-color: transparent;
}

input,
textarea {
  color: var(--app-text);
}

.glass,
.surface {
  background: color-mix(in srgb, var(--app-surface) 97%, transparent);
  backdrop-filter: blur(8px);
  border: 1px solid var(--app-border);
}

.surface-soft {
  background: var(--app-soft);
}

.gradient-text {
  background: var(--app-accent-fill);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.scrollbar-thin::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

.scrollbar-thin::-webkit-scrollbar-thumb {
  background: var(--app-soft-strong);
  border-radius: 999px;
}

.scrollbar-thin::-webkit-scrollbar-track {
  background: transparent;
}

/* ------------------------------------------------------------------
   Compatibilidad temática con las clases ya usadas en Alumni 2.0/3.0.
   Permite cambiar TODA la app sin reescribir cada pantalla.
   ------------------------------------------------------------------ */

html[data-theme] [class~="bg-[#090b0f]"],
html[data-theme] [class~="bg-[#09090B]"],
html[data-theme] [class~="bg-[#0b0e13]"] {
  background-color: var(--app-bg) !important;
}

html[data-theme] [class~="bg-[#090b0f]/90"],
html[data-theme] [class~="bg-[#090b0f]/95"],
html[data-theme] [class~="bg-[#0b0e13]/95"] {
  background-color: var(--app-topbar) !important;
}

html[data-theme] [class~="bg-[#101318]/95"],
html[data-theme] [class~="bg-[#101318]"],
html[data-theme] [class~="bg-zinc-900"],
html[data-theme] [class~="bg-zinc-900/70"],
html[data-theme] [class~="bg-zinc-950/80"] {
  background-color: var(--app-surface) !important;
}

html[data-theme] [class~="bg-[#1a1f29]"],
html[data-theme] [class~="bg-[#181c24]"],
html[data-theme] [class~="bg-[#171b23]"],
html[data-theme] [class~="bg-zinc-800"],
html[data-theme] [class~="bg-zinc-700"] {
  background-color: var(--app-surface-2) !important;
}

html[data-theme] [class~="bg-white/[0.025]"],
html[data-theme] [class~="bg-white/[0.035]"],
html[data-theme] [class~="bg-white/[0.04]"],
html[data-theme] [class~="bg-white/[0.05]"],
html[data-theme] [class~="bg-white/[0.055]"],
html[data-theme] [class~="bg-white/[0.06]"],
html[data-theme] [class~="bg-white/[0.07]"] {
  background-color: var(--app-soft) !important;
}

html[data-theme] [class~="bg-[#6d7cff]"],
html[data-theme] [class~="bg-[#7b87ff]"] {
  background: var(--app-accent-fill) !important;
  color: var(--app-on-accent) !important;
}

html[data-theme] [class~="hover:bg-[#7b87ff]"]:hover,
html[data-theme] [class~="hover:bg-[#6d7cff]"]:hover {
  background: var(--app-accent-fill) !important;
  filter: brightness(1.06);
}

html[data-theme] [class~="bg-[#6d7cff]/10"],
html[data-theme] [class~="bg-[#7f8cff]/10"] {
  background-color: var(--app-accent-soft) !important;
}

html[data-theme] [class~="text-white"] {
  color: var(--app-text) !important;
}

html[data-theme] [class~="bg-[#6d7cff]"][class~="text-white"],
html[data-theme] [class~="bg-[#7b87ff]"][class~="text-white"],
html[data-theme] [class~="bg-black"][class~="text-white"],
html[data-theme] [class~="bg-black/55"][class~="text-white"],
html[data-theme] [class~="bg-black/70"][class~="text-white"],
html[data-theme] [class~="bg-black/90"][class~="text-white"] {
  color: var(--app-on-accent) !important;
}

html[data-theme] [class~="text-zinc-100"],
html[data-theme] [class~="text-zinc-200"],
html[data-theme] [class~="text-zinc-300"] {
  color: var(--app-text-soft) !important;
}

html[data-theme] [class~="text-zinc-400"],
html[data-theme] [class~="text-zinc-500"] {
  color: var(--app-muted) !important;
}

html[data-theme] [class~="text-zinc-600"] {
  color: var(--app-muted-2) !important;
}

html[data-theme] [class~="text-zinc-700"],
html[data-theme] [class~="text-zinc-800"] {
  color: var(--app-muted-3) !important;
}

html[data-theme] [class~="text-[#8d98ff]"],
html[data-theme] [class~="text-[#7f8cff]"],
html[data-theme] [class~="text-[#9ba5ff]"] {
  color: var(--app-accent) !important;
}

html[data-theme] [class~="border-white/[0.06]"],
html[data-theme] [class~="border-white/[0.07]"],
html[data-theme] [class~="border-white/[0.08]"],
html[data-theme] [class~="border-white/[0.09]"],
html[data-theme] [class~="border-white/10"] {
  border-color: var(--app-border) !important;
}

html[data-theme] [class~="ring-white/10"] {
  --tw-ring-color: var(--app-border) !important;
}

html[data-theme] [class~="focus:border-[#6d7cff]/35"]:focus,
html[data-theme] [class~="focus:border-[#6d7cff]/40"]:focus,
html[data-theme] [class~="focus:border-[#6d7cff]/45"]:focus,
html[data-theme] [class~="focus-within:border-[#6d7cff]/35"]:focus-within,
html[data-theme] [class~="focus-within:border-[#6d7cff]/40"]:focus-within,
html[data-theme] [class~="focus-within:border-[#6d7cff]/45"]:focus-within {
  border-color: color-mix(in srgb, var(--app-accent) 48%, transparent) !important;
}

html[data-theme="light"] img {
  color-scheme: light;
}

/* ==================================================================
   ALUMNI VISUAL + THEME AUDIT 11.0
   Capa global para que Dark y Light mantengan
   contraste, superficies y estados coherentes.
   ================================================================== */

:root {
  --app-danger: #ef5b68;
  --app-success: #3dbb7f;
  --app-warning: #d6a340;
}

.alumni-accent-button {
  background: var(--app-accent-fill);
  color: var(--app-on-accent);
  box-shadow: 0 10px 28px color-mix(in srgb, var(--app-accent) 18%, transparent);
}

.alumni-accent-button:hover {
  filter: brightness(1.045);
}

.alumni-composer {
  border-color: var(--app-border);
  background:
    linear-gradient(
      180deg,
      color-mix(in srgb, var(--app-surface) 97%, transparent),
      color-mix(in srgb, var(--app-surface) 91%, transparent)
    );
  box-shadow: 0 18px 55px var(--app-shadow);
}

.alumni-post-card {
  border-color: var(--app-border) !important;
  background:
    linear-gradient(
      180deg,
      color-mix(in srgb, var(--app-surface) 98%, transparent),
      color-mix(in srgb, var(--app-surface) 94%, transparent)
    ) !important;
  box-shadow:
    0 1px 0 color-mix(in srgb, var(--app-text) 2%, transparent),
    0 18px 55px var(--app-shadow);
}

.alumni-post-card:hover {
  border-color: color-mix(in srgb, var(--app-accent) 18%, var(--app-border)) !important;
}

.alumni-post-avatar {
  box-shadow:
    0 0 0 1px var(--app-border),
    0 7px 20px var(--app-shadow);
}

.alumni-post-copy {
  color: var(--app-text-soft) !important;
  letter-spacing: -0.006em;
}

.alumni-post-media {
  padding: 0 12px;
  background: transparent !important;
}

.alumni-post-media img {
  border-radius: 18px;
  background: var(--app-bg-2);
  box-shadow: 0 10px 36px var(--app-shadow);
}

.alumni-post-footer {
  padding-top: 12px;
}

.alumni-post-stats {
  color: var(--app-muted-2);
}

.alumni-post-actions {
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 4px !important;
  border-color: var(--app-border) !important;
}

.alumni-post-actions > button {
  width: 100%;
  justify-content: center;
  margin-left: 0 !important;
}

.alumni-comment-bubble {
  background: var(--app-soft) !important;
  border: 1px solid color-mix(in srgb, var(--app-border) 75%, transparent);
}

.alumni-comment-input {
  border-color: var(--app-border) !important;
  background: var(--app-soft) !important;
}

.alumni-story-tile {
  border: 1px solid var(--app-border);
  background: var(--app-surface-2);
  box-shadow: 0 12px 28px var(--app-shadow);
  isolation: isolate;
}

.alumni-story-unseen {
  border-color: color-mix(in srgb, var(--app-accent) 72%, white 12%);
  box-shadow:
    0 0 0 2px color-mix(in srgb, var(--app-accent) 14%, transparent),
    0 12px 28px var(--app-shadow);
}

.alumni-story-viewed {
  border-color: var(--app-border);
  filter: saturate(.78);
}

.alumni-story-tile:active {
  transform: scale(.985);
}

.alumni-chat-composer {
  border-color: var(--app-border);
  background: color-mix(in srgb, var(--app-soft-strong) 78%, transparent);
  box-shadow:
    0 8px 30px var(--app-shadow),
    inset 0 1px 0 color-mix(in srgb, var(--app-text) 3%, transparent);
}

.alumni-chat-composer:focus-within {
  border-color: color-mix(in srgb, var(--app-accent) 42%, transparent);
  background: color-mix(in srgb, var(--app-surface-2) 52%, var(--app-soft));
}

.alumni-message-mine {
  background: var(--app-accent-fill);
  color: var(--app-on-accent);
  box-shadow: 0 8px 20px color-mix(in srgb, var(--app-accent) 13%, transparent);
}

.alumni-message-other {
  background: var(--app-soft-strong);
  color: var(--app-text-soft);
}

.alumni-message-media-mine {
  border-color: color-mix(in srgb, var(--app-accent) 28%, transparent);
  background: var(--app-accent-soft);
}

.profile-banner-fallback {
  background:
    radial-gradient(
      circle at 18% 10%,
      color-mix(in srgb, var(--app-accent) 30%, transparent),
      transparent 40%
    ),
    radial-gradient(
      circle at 85% 20%,
      color-mix(in srgb, var(--app-accent-2) 19%, transparent),
      transparent 36%
    ),
    var(--app-bg-2);
}

/* Los visores multimedia deben conservar controles oscuros aunque
   la aplicación esté en tema Claro. */
[data-theme-lock="dark"] {
  --app-bg: #050506;
  --app-bg-2: #090b0f;
  --app-surface: #101318;
  --app-surface-2: #191e27;
  --app-soft: rgba(255,255,255,.04);
  --app-soft-strong: rgba(255,255,255,.075);
  --app-border: rgba(255,255,255,.10);
  --app-text: #ffffff;
  --app-text-soft: #e5e7eb;
  --app-muted: #a1a1aa;
  --app-muted-2: #71717a;
  --app-muted-3: #52525b;
  --app-accent: #8d98ff;
  --app-accent-2: #6d7cff;
  --app-accent-fill: linear-gradient(135deg,#6d7cff,#7f8cff);
  --app-accent-soft: rgba(109,124,255,.14);
  --app-on-accent: #ffffff;
  --app-topbar: rgba(5,5,6,.90);
  --app-shadow: rgba(0,0,0,.40);
  color-scheme: dark;
}

/* Superficies hardcodeadas que existían antes del sistema de temas. */
html[data-theme] [class~="bg-[#0d1015]"],
html[data-theme] [class~="bg-[#0d1015]/96"],
html[data-theme] [class~="bg-[#181d27]"],
html[data-theme] [class~="bg-[#151a23]"],
html[data-theme] [class~="bg-[#11151c]"] {
  background-color: var(--app-surface) !important;
}

html[data-theme] [class~="bg-[#181d27]"],
html[data-theme] [class~="bg-[#151a23]"] {
  background-color: var(--app-surface-2) !important;
}

html[data-theme] [class~="bg-[#6d7cff]/12"],
html[data-theme] [class~="bg-[#6d7cff]/[0.06]"],
html[data-theme] [class~="bg-[#6d7cff]/[0.07]"],
html[data-theme] [class~="bg-[#7f8cff]/[0.07]"] {
  background-color: var(--app-accent-soft) !important;
}

html[data-theme] [class~="bg-white/[0.018]"],
html[data-theme] [class~="bg-white/[0.08]"],
html[data-theme] [class~="bg-white/[0.09]"],
html[data-theme] [class~="bg-white/[0.10]"],
html[data-theme] [class~="bg-white/[0.1]"],
html[data-theme] [class~="bg-white/10"] {
  background-color: var(--app-soft) !important;
}

html[data-theme] [class~="hover:bg-white/[0.025]"]:hover,
html[data-theme] [class~="hover:bg-white/[0.03]"]:hover,
html[data-theme] [class~="hover:bg-white/[0.035]"]:hover,
html[data-theme] [class~="hover:bg-white/[0.04]"]:hover,
html[data-theme] [class~="hover:bg-white/[0.05]"]:hover,
html[data-theme] [class~="hover:bg-white/[0.055]"]:hover,
html[data-theme] [class~="hover:bg-white/[0.06]"]:hover,
html[data-theme] [class~="hover:bg-white/[0.07]"]:hover,
html[data-theme] [class~="hover:bg-white/[0.08]"]:hover,
html[data-theme] [class~="hover:bg-white/[0.1]"]:hover,
html[data-theme] [class~="hover:bg-white/10"]:hover {
  background-color: var(--app-soft-strong) !important;
}

html[data-theme] [class~="disabled:bg-white/[0.06]"]:disabled {
  background: var(--app-soft) !important;
}

html[data-theme] [class~="hover:text-white"]:hover {
  color: var(--app-text) !important;
}

html[data-theme] [class~="hover:text-zinc-100"]:hover,
html[data-theme] [class~="hover:text-zinc-200"]:hover,
html[data-theme] [class~="hover:text-zinc-300"]:hover {
  color: var(--app-text-soft) !important;
}

html[data-theme] [class~="hover:text-zinc-400"]:hover,
html[data-theme] [class~="hover:text-zinc-500"]:hover {
  color: var(--app-muted) !important;
}

html[data-theme] [class~="text-[#9da6ff]"],
html[data-theme] [class~="text-[#9ba5ff]"] {
  color: var(--app-accent) !important;
}

html[data-theme] [class~="border-white/[0.10]"],
html[data-theme] [class~="border-white/[0.1]"],
html[data-theme] [class~="border-white/15"] {
  border-color: var(--app-border) !important;
}

html[data-theme] [class~="border-[#6d7cff]/25"],
html[data-theme] [class~="border-[#6d7cff]/30"],
html[data-theme] [class~="border-[#7f8cff]/20"],
html[data-theme] [class~="border-[#7f8cff]/35"] {
  border-color: color-mix(in srgb, var(--app-accent) 34%, transparent) !important;
}

html[data-theme] [class~="ring-[#090b0f]"],
html[data-theme] [class~="ring-[#0b0e13]"] {
  --tw-ring-color: var(--app-bg) !important;
}

html[data-theme] [class~="divide-white/[0.06]"] > :not(:last-child),
html[data-theme] [class~="divide-white/[0.07]"] > :not(:last-child),
html[data-theme] [class~="divide-white/[0.08]"] > :not(:last-child) {
  border-color: var(--app-border) !important;
}

html[data-theme] [class~="placeholder:text-zinc-500"]::placeholder {
  color: var(--app-muted) !important;
}

html[data-theme] [class~="placeholder:text-zinc-600"]::placeholder {
  color: var(--app-muted-2) !important;
}

html[data-theme] [class~="placeholder:text-zinc-700"]::placeholder {
  color: var(--app-muted-3) !important;
}

html[data-theme] [class~="focus-within:border-[#6d7cff]/50"]:focus-within,
html[data-theme] [class~="focus:border-[#6d7cff]/50"]:focus {
  border-color: color-mix(in srgb, var(--app-accent) 50%, transparent) !important;
}

select,
option {
  color: var(--app-text);
  background-color: var(--app-surface);
}

input[type="date"],
input[type="time"],
input[type="datetime-local"] {
  color-scheme: inherit;
}

@media (max-width: 640px) {
  .alumni-post-card {
    border-radius: 20px !important;
  }

  .alumni-post-media {
    padding-inline: 10px;
  }

  .alumni-post-media img {
    border-radius: 16px;
  }

  .alumni-story-tile {
    width: 88px;
    height: 128px;
  }
}


/* ALUMNI MOBILE CHAT 11.1 */
.alumni-chat-composer textarea {
  touch-action: manipulation;
}

@media (max-width: 767px) {
  .alumni-chat-composer textarea,
  .alumni-chat-composer input {
    font-size: 16px !important;
  }

  .alumni-stories-section {
    margin-top: 2px;
  }
}

/* ALUMNI STORIES 12.0 */
.story-field {
  width: 100%;
  min-height: 46px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,.075);
  background: rgba(255,255,255,.035);
  padding-left: 13px;
  padding-right: 13px;
  font-size: 13px;
  color: #e4e4e7;
  outline: none;
  transition: border-color .18s ease, background .18s ease;
}

.story-field::placeholder {
  color: #52525b;
}

.story-field:focus {
  border-color: rgba(109,124,255,.48);
  background: rgba(255,255,255,.05);
}

.story-kind-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  border-radius: 999px;
  padding: 5px 8px;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .06em;
  text-transform: uppercase;
  backdrop-filter: blur(16px);
}

.story-kind-achievement {
  border: 1px solid rgba(165,180,252,.25);
  background: rgba(79,70,229,.28);
  color: #e0e7ff;
}

.story-kind-opportunity {
  border: 1px solid rgba(110,231,183,.22);
  background: rgba(5,150,105,.25);
  color: #d1fae5;
}

/* ALUMNI STORIES 12.1 - STUDIO */
.story-field {
  width: 100%;
  min-height: 46px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,.075);
  background: rgba(255,255,255,.035);
  padding-left: 13px;
  padding-right: 13px;
  font-size: 13px;
  color: #e4e4e7;
  outline: none;
  transition: border-color .18s ease, background .18s ease, box-shadow .18s ease;
}

.story-field::placeholder {
  color: #52525b;
}

.story-field:focus {
  border-color: rgba(109,124,255,.5);
  background: rgba(255,255,255,.05);
  box-shadow: 0 0 0 3px rgba(109,124,255,.08);
}

.story-decor-grid {
  background-image:
    linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
  background-size: 38px 38px;
  mask-image: linear-gradient(to bottom, black, transparent 82%);
}

.story-confetti {
  background-image:
    radial-gradient(circle at 12% 18%, rgba(255,255,255,.42) 0 2px, transparent 3px),
    radial-gradient(circle at 80% 20%, rgba(129,140,248,.56) 0 3px, transparent 4px),
    radial-gradient(circle at 66% 42%, rgba(255,255,255,.28) 0 2px, transparent 3px),
    radial-gradient(circle at 22% 58%, rgba(167,139,250,.52) 0 3px, transparent 4px),
    radial-gradient(circle at 84% 66%, rgba(255,255,255,.25) 0 2px, transparent 3px);
}

@keyframes alumniStoryFade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes alumniStoryRise {
  from { opacity: 0; transform: translateY(28px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes alumniStoryPop {
  0% { opacity: 0; transform: scale(.88); }
  70% { opacity: 1; transform: scale(1.035); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes alumniStoryGlow {
  0% { opacity: 0; filter: blur(8px); }
  55% { opacity: 1; filter: blur(0); text-shadow: 0 0 22px rgba(255,255,255,.22); }
  100% { opacity: 1; filter: blur(0); }
}

@keyframes alumniStoryFloat {
  0% { opacity: 0; transform: translateY(18px) scale(.98); }
  65% { opacity: 1; transform: translateY(-4px) scale(1); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes alumniStoryReveal {
  from { opacity: 0; clip-path: inset(0 100% 0 0); }
  to { opacity: 1; clip-path: inset(0 0 0 0); }
}

.story-anim-fade {
  animation: alumniStoryFade .65s ease both;
}

.story-anim-rise {
  animation: alumniStoryRise .72s cubic-bezier(.22,.8,.24,1) both;
}

.story-anim-pop {
  animation: alumniStoryPop .72s cubic-bezier(.2,.75,.2,1) both;
}

.story-anim-glow {
  animation: alumniStoryGlow .8s ease both;
}

.story-anim-float {
  animation: alumniStoryFloat .9s cubic-bezier(.2,.7,.2,1) both;
}

.story-anim-reveal {
  animation: alumniStoryReveal .85s cubic-bezier(.2,.8,.2,1) both;
}

@media (prefers-reduced-motion: reduce) {
  .story-anim-fade,
  .story-anim-rise,
  .story-anim-pop,
  .story-anim-glow,
  .story-anim-float,
  .story-anim-reveal {
    animation: none !important;
  }
}

/* ============================================================
   ALUMNI v1.0.5 — MENSAJES PRO + ESTABILIDAD MÓVIL
   ============================================================ */

html,
body {
  min-height: 100%;
  min-height: 100dvh;
  max-width: 100%;
  overflow-x: clip;
}

button,
a,
[role="button"] {
  touch-action: manipulation;
}

.alumni-messages-page {
  isolation: isolate;
}

.alumni-messages-search {
  background:
    linear-gradient(
      90deg,
      color-mix(in srgb, var(--app-accent) 4%, transparent),
      transparent 32%
    );
}

.alumni-conversation-row {
  min-height: 82px;
}

.alumni-conversation-row::before {
  content: "";
  position: absolute;
  inset: 6px -10px;
  z-index: -1;
  border-radius: 18px;
  background: transparent;
  transition:
    background-color .18s ease,
    transform .18s ease;
}

.alumni-conversation-row:hover::before {
  background:
    color-mix(
      in srgb,
      var(--app-soft-strong) 72%,
      transparent
    );
}

.alumni-conversation-row:active::before {
  background:
    color-mix(
      in srgb,
      var(--app-soft-strong) 92%,
      transparent
    );
  transform: scale(.995);
}

.alumni-conversation-unread::before {
  background:
    linear-gradient(
      90deg,
      color-mix(
        in srgb,
        var(--app-accent) 8%,
        transparent
      ),
      transparent 74%
    );
}

.alumni-chat-stage {
  contain: layout paint;
}

.alumni-chat-wallpaper {
  background:
    radial-gradient(
      circle at 12% 8%,
      color-mix(
        in srgb,
        var(--app-accent) 5%,
        transparent
      ),
      transparent 27%
    ),
    radial-gradient(
      circle at 88% 76%,
      color-mix(
        in srgb,
        var(--app-accent-2) 4%,
        transparent
      ),
      transparent 24%
    ),
    linear-gradient(
      to bottom,
      color-mix(
        in srgb,
        var(--app-bg-2) 30%,
        transparent
      ),
      transparent 26%
    );
}

.alumni-chat-scroll {
  -webkit-overflow-scrolling: touch;
  scrollbar-gutter: stable;
  scroll-padding-bottom: 14px;
}

.alumni-message-bubble {
  border-radius: 20px;
  box-shadow:
    0 5px 15px
      color-mix(
        in srgb,
        var(--app-shadow) 66%,
        transparent
      );
}

.alumni-message-other {
  border:
    1px solid
      color-mix(
        in srgb,
        var(--app-border) 82%,
        transparent
      );
  background:
    color-mix(
      in srgb,
      var(--app-surface-2) 72%,
      var(--app-surface)
    );
}

.alumni-chat-composer-shell {
  box-shadow:
    0 -18px 45px
      color-mix(
        in srgb,
        var(--app-shadow) 45%,
        transparent
      );
}

.alumni-chat-composer {
  background:
    color-mix(
      in srgb,
      var(--app-surface-2) 76%,
      transparent
    );
  box-shadow:
    inset 0 1px 0
      color-mix(
        in srgb,
        var(--app-text) 3%,
        transparent
      ),
    0 10px 28px
      color-mix(
        in srgb,
        var(--app-shadow) 54%,
        transparent
      );
}

.alumni-chat-composer:focus-within {
  border-color:
    color-mix(
      in srgb,
      var(--app-accent) 38%,
      var(--app-border)
    );
  box-shadow:
    0 0 0 3px
      color-mix(
        in srgb,
        var(--app-accent) 7%,
        transparent
      ),
    0 10px 28px
      color-mix(
        in srgb,
        var(--app-shadow) 54%,
        transparent
      );
}

@media (max-width: 767px) {
  .alumni-mobile-input {
    font-size: 16px !important;
  }

  .alumni-chat-stage {
    width: 100%;
    max-width: none;
    border-radius: 0;
  }

  .alumni-chat-scroll {
    scrollbar-width: none;
  }

  .alumni-chat-scroll::-webkit-scrollbar {
    display: none;
  }

  .alumni-conversation-row::before {
    inset-inline: -6px;
  }

  .alumni-story-studio-panel {
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }
}

@media (prefers-reduced-motion: reduce) {
  .alumni-conversation-row::before,
  .alumni-message-new {
    transition: none !important;
  }
}


/* ALUMNI v1.0.6 — BRANDING + PULIDO GLOBAL */

.alumni-brand {
  line-height: 1;
  text-rendering: geometricPrecision;
  font-feature-settings: "kern" 1, "liga" 1;
}

.alumni-brand-dot {
  display: inline-block;
  margin-left: .045em;
  color: var(--app-accent);
  transform-origin: center bottom;
}

.alumni-brand-dot-animated {
  animation: alumniBrandDotPulse 2.2s ease-in-out infinite;
  text-shadow:
    0 0 16px color-mix(in srgb, var(--app-accent) 52%, transparent);
}

@keyframes alumniBrandDotPulse {
  0%,
  100% {
    opacity: .82;
    transform: scale(1);
  }

  50% {
    opacity: 1;
    transform: scale(1.18);
  }
}

/* Inputs profesionales en móvil:
   evita zoom accidental de iOS y saltos de layout. */
@media (max-width: 767px) {
  input,
  textarea,
  select {
    font-size: 16px;
  }

  body {
    overscroll-behavior-y: none;
  }
}

/* Mejor comportamiento para superficies desplazables. */
.scrollbar-thin,
.alumni-story-studio-panel,
.alumni-chat-scroll {
  -webkit-overflow-scrolling: touch;
}

/* Jerarquía visual más consistente entre módulos. */
main {
  min-width: 0;
}

img,
video {
  max-width: 100%;
}

@media (prefers-reduced-motion: reduce) {
  .alumni-brand-dot-animated {
    animation: none !important;
  }
}

/* ============================================================
   ALUMNI v1.0.8 — PULIDO GLOBAL PRO
   ============================================================ */

.alumni-profile-page,
.alumni-feed-page,
.alumni-explore-page,
.alumni-notifications-page,
.alumni-events-page,
.alumni-settings-page {
  animation: alumniPageIn .28s ease both;
}

@keyframes alumniPageIn {
  from {
    opacity: 0;
    transform: translateY(4px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.alumni-section-tabs {
  scrollbar-width: none;
}

.alumni-section-tabs::-webkit-scrollbar {
  display: none;
}

.alumni-section-tabs > button {
  min-height: 42px;
}

.alumni-empty-state {
  background:
    radial-gradient(
      circle at 50% 0%,
      color-mix(in srgb, var(--app-accent) 6%, transparent),
      transparent 58%
    );
}

/* ---------------- PROFILE ---------------- */

.alumni-profile-hero {
  overflow: visible !important;
  background:
    linear-gradient(
      to bottom,
      color-mix(in srgb, var(--app-surface) 98%, transparent),
      var(--app-surface)
    ) !important;
  box-shadow:
    0 22px 60px
      color-mix(in srgb, var(--app-shadow) 54%, transparent);
}

.alumni-profile-banner {
  position: relative;
}

.alumni-profile-banner::after {
  content: "";
  position: absolute;
  inset: auto 0 0;
  height: 72px;
  pointer-events: none;
  background:
    linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--app-surface) 76%, transparent)
    );
}

.alumni-profile-avatar {
  position: relative;
  z-index: 4;
  box-shadow:
    0 0 0 5px var(--app-surface),
    0 14px 38px var(--app-shadow) !important;
}

.alumni-profile-stats {
  gap: clamp(20px, 6vw, 46px) !important;
}

.alumni-profile-stats > div p:first-child {
  letter-spacing: -.03em;
}

.alumni-open-info {
  background:
    color-mix(
      in srgb,
      var(--app-surface) 76%,
      transparent
    ) !important;
  box-shadow: none !important;
}

/* ---------------- FEED ---------------- */

.alumni-feed-tabs {
  position: sticky;
  top: 68px;
  z-index: 24;
  margin-inline: -6px;
  padding-inline: 6px;
  padding-top: 8px;
  background:
    color-mix(
      in srgb,
      var(--app-bg) 91%,
      transparent
    );
  backdrop-filter: blur(18px);
}

.alumni-media-viewer {
  overscroll-behavior: none;
  backdrop-filter: blur(10px);
}

/* ---------------- EXPLORE ---------------- */

.alumni-search-line {
  border-radius: 18px !important;
  background:
    color-mix(
      in srgb,
      var(--app-surface-2) 58%,
      transparent
    ) !important;
  box-shadow:
    inset 0 1px 0
      color-mix(in srgb, var(--app-text) 2%, transparent);
}

.alumni-search-line:focus-within {
  box-shadow:
    0 0 0 3px
      color-mix(in srgb, var(--app-accent) 7%, transparent);
}

.alumni-filter-strip {
  overscroll-behavior-x: contain;
  scroll-snap-type: x proximity;
}

.alumni-filter-strip > button {
  scroll-snap-align: start;
}

.alumni-profile-suggestion {
  box-shadow:
    0 10px 28px
      color-mix(in srgb, var(--app-shadow) 38%, transparent);
}

.alumni-profile-suggestion:hover {
  border-color:
    color-mix(
      in srgb,
      var(--app-accent) 18%,
      var(--app-border)
    ) !important;
}

.alumni-open-list {
  border-inline: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
}

.alumni-directory-row {
  border-radius: 18px;
}

.alumni-directory-row:hover {
  background:
    color-mix(
      in srgb,
      var(--app-soft-strong) 74%,
      transparent
    ) !important;
}

/* ---------------- NOTIFICATIONS ---------------- */

.alumni-notification-row {
  position: relative;
  border-radius: 18px;
}

.alumni-notification-unread {
  background:
    linear-gradient(
      90deg,
      color-mix(in srgb, var(--app-accent) 8%, transparent),
      transparent 72%
    );
}

.alumni-notification-unread::before {
  content: "";
  position: absolute;
  left: 4px;
  top: 50%;
  width: 5px;
  height: 5px;
  border-radius: 999px;
  background: var(--app-accent);
  transform: translateY(-50%);
}

/* ---------------- EVENTS ---------------- */

.alumni-event-hero {
  box-shadow:
    0 24px 70px
      color-mix(in srgb, var(--app-shadow) 58%, transparent);
}

.alumni-event-row {
  background:
    color-mix(
      in srgb,
      var(--app-surface) 74%,
      transparent
    ) !important;
  box-shadow:
    0 10px 28px
      color-mix(in srgb, var(--app-shadow) 30%, transparent);
}

.alumni-event-row:hover {
  transform: translateY(-1px);
  box-shadow:
    0 15px 36px
      color-mix(in srgb, var(--app-shadow) 44%, transparent);
}

.alumni-event-share {
  min-width: 104px;
}

/* ---------------- SETTINGS ---------------- */

.alumni-settings-panel {
  background:
    color-mix(
      in srgb,
      var(--app-surface) 84%,
      transparent
    ) !important;
  box-shadow:
    0 12px 34px
      color-mix(in srgb, var(--app-shadow) 30%, transparent);
}

.alumni-settings-detail {
  min-height: 420px;
}

/* ---------------- QUALITY / MOBILE ---------------- */

@media (max-width: 1023px) {
  .alumni-settings-nav {
    border-top: 1px solid var(--app-border);
  }

  .alumni-settings-detail {
    min-height: calc(
      100dvh -
      84px -
      env(safe-area-inset-bottom)
    );
  }
}

@media (max-width: 767px) {
  .alumni-profile-hero {
    margin-inline: -4px;
    border-radius: 22px !important;
  }

  .alumni-profile-banner {
    border-radius: 21px 21px 0 0 !important;
  }

  .alumni-profile-body {
    padding-inline: 16px !important;
  }

  .alumni-profile-identity {
    gap: 12px !important;
  }

  .alumni-profile-avatar {
    width: 84px !important;
    height: 84px !important;
    margin-top: -48px;
  }

  .alumni-profile-stats {
    justify-content: space-between;
    gap: 12px !important;
  }

  .alumni-feed-tabs {
    top: 68px;
  }

  .alumni-recommended-grid {
    grid-auto-flow: column;
    grid-auto-columns: minmax(280px, 84vw);
    grid-template-columns: none !important;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    padding-bottom: 4px;
    scrollbar-width: none;
  }

  .alumni-recommended-grid::-webkit-scrollbar {
    display: none;
  }

  .alumni-profile-suggestion {
    scroll-snap-align: start;
  }

  .alumni-directory-row {
    padding-inline: 4px !important;
  }

  .alumni-event-row {
    border-inline: 0 !important;
    border-radius: 18px !important;
    box-shadow: none;
  }

  .alumni-event-share {
    align-self: stretch;
  }

  .alumni-notification-row {
    padding-inline: 6px !important;
  }

  .alumni-settings-panel {
    margin-inline: -4px;
    border-inline: 0 !important;
    border-radius: 18px !important;
    box-shadow: none;
  }

  .alumni-settings-detail > div:first-child {
    position: sticky;
    top: 0;
    z-index: 25;
    padding-block: 10px;
    background:
      color-mix(
        in srgb,
        var(--app-bg) 92%,
        transparent
      );
    backdrop-filter: blur(18px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .alumni-profile-page,
  .alumni-feed-page,
  .alumni-explore-page,
  .alumni-notifications-page,
  .alumni-events-page,
  .alumni-settings-page {
    animation: none !important;
  }

  .alumni-event-row {
    transition: none !important;
  }
}


/* ALUMNI v1.0.9 — CUENTA PRIVADA + TABS LIMPIOS */

.alumni-section-tabs,
.alumni-feed-tabs {
  position: static !important;
  top: auto !important;
  z-index: auto !important;
  margin-inline: 0 !important;
  padding-inline: 0 !important;
  padding-top: 0 !important;
  background: transparent !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  box-shadow: none !important;
}

.alumni-section-tabs > button {
  border-radius: 0 !important;
  background: transparent !important;
}

.alumni-section-tabs > button:hover {
  background: transparent !important;
}

.alumni-feed-tabs {
  border-bottom: 1px solid var(--app-border) !important;
}

.alumni-private-lock {
  min-height: 280px;
}

@media (max-width: 767px) {
  .alumni-section-tabs,
  .alumni-feed-tabs {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .alumni-section-tabs::-webkit-scrollbar,
  .alumni-feed-tabs::-webkit-scrollbar {
    display: none;
  }
}


/* ALUMNI v1.0.10 — PERFIL PRO */

/* Ajustes abiertos, sin la barra/panel negro. */
.alumni-settings-nav {
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
}

.alumni-settings-nav > div:first-child {
  border-bottom: 1px solid var(--app-border) !important;
  padding-inline: 0 !important;
}

.alumni-settings-nav nav {
  padding-inline: 0 !important;
}

.alumni-settings-nav nav button {
  border-radius: 0 !important;
  background: transparent !important;
  padding-inline: 0 !important;
}

.alumni-settings-nav nav button:hover {
  background: transparent !important;
}

.alumni-settings-detail > div:first-child {
  position: static !important;
  top: auto !important;
  padding-block: 0 10px !important;
  background: transparent !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  box-shadow: none !important;
}

/* Perfil > hub tipo ajustes de red social. */
.alumni-profile-settings-hub {
  border-top: 1px solid var(--app-border);
  border-bottom: 1px solid var(--app-border);
}

.alumni-setting-row {
  display: flex;
  min-height: 72px;
  align-items: center;
  gap: 12px;
  padding: 12px 2px;
}

.alumni-privacy-switch {
  position: relative;
  display: block;
  width: 46px;
  min-width: 46px;
  height: 26px;
  flex: 0 0 46px;
  overflow: hidden;
  border-radius: 999px;
  background: var(--app-soft-strong);
  padding: 0 !important;
}

.alumni-privacy-switch > span {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 20px;
  height: 20px;
  border-radius: 999px;
  background: #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,.22);
  transform: translateX(0);
  transition: transform .2s ease;
}

.alumni-privacy-switch.is-on {
  background: var(--app-accent);
}

.alumni-privacy-switch.is-on > span {
  transform: translateX(20px);
}

/* Editor de perfil */
.alumni-profile-editor {
  overflow: hidden;
  border-top: 1px solid var(--app-border);
}

.alumni-profile-editor-top {
  display: flex;
  min-height: 58px;
  align-items: center;
  gap: 10px;
  border-bottom: 1px solid var(--app-border);
  padding-block: 8px;
}

.alumni-profile-editor-media {
  padding-bottom: 10px;
}

.alumni-profile-editor-fields {
  border-top: 1px solid var(--app-border);
}

.alumni-edit-row {
  display: flex;
  min-height: 58px;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid var(--app-border);
  padding: 11px 2px;
}

.alumni-profile-chip {
  display: inline-flex;
  min-height: 40px;
  align-items: center;
  gap: 8px;
  border: 1px solid var(--app-border);
  border-radius: 13px;
  background:
    color-mix(
      in srgb,
      var(--app-surface-2) 55%,
      transparent
    );
  padding: 5px 9px 5px 5px;
}

/* Paneles de ajustes: menos cajas. */
.alumni-settings-panel {
  border-inline: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  padding-inline: 2px !important;
}

/* La cabecera de Perfil no necesita el antiguo fondo sticky. */
@media (max-width: 767px) {
  .alumni-settings-page {
    padding-bottom: env(safe-area-inset-bottom);
  }

  .alumni-settings-nav > div:first-child {
    display: none;
  }

  .alumni-settings-nav {
    border-top: 0 !important;
  }

  .alumni-profile-settings-hub {
    margin-inline: 0;
  }

  .alumni-setting-row {
    min-height: 68px;
  }

  .alumni-profile-editor {
    margin-inline: -4px;
  }

  .alumni-profile-editor-top {
    position: sticky;
    top: 0;
    z-index: 40;
    background:
      color-mix(
        in srgb,
        var(--app-bg) 94%,
        transparent
      );
    backdrop-filter: blur(18px);
  }

  .alumni-edit-row {
    padding-inline: 4px;
  }
}


/* ================================================================
   ALUMNI 1.0.13 — Perfil premium + logos originales monocromáticos
   ================================================================ */

.alumni-original-logo {
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  overflow: visible;
}

.alumni-original-logo-image {
  display: block;
  background: transparent !important;
  filter: grayscale(1) contrast(1.18);
  opacity: .9;
  transition: opacity .18s ease, filter .18s ease, transform .18s ease;
}

html[data-theme="light"] .alumni-original-logo-image {
  mix-blend-mode: multiply;
}

html[data-theme="dark"] .alumni-original-logo-image {
  filter: grayscale(1) invert(1) contrast(1.2);
  mix-blend-mode: screen;
  opacity: .84;
}

.alumni-premium-meta:hover .alumni-original-logo-image {
  opacity: 1;
}

.alumni-profile-hero {
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
}

.alumni-profile-banner {
  border-radius: 28px !important;
  box-shadow:
    0 24px 70px color-mix(in srgb, var(--app-shadow) 70%, transparent),
    0 0 0 1px var(--app-border);
}

.alumni-profile-body {
  position: relative;
  padding-top: 0 !important;
}

.alumni-profile-identity {
  margin-top: -46px;
  position: relative;
  z-index: 2;
}

.alumni-profile-avatar {
  border: 5px solid var(--app-bg) !important;
  box-shadow:
    0 16px 42px color-mix(in srgb, var(--app-shadow) 78%, transparent),
    0 0 0 1px var(--app-border) !important;
}

.alumni-profile-stats {
  gap: 2.2rem !important;
}

.alumni-premium-meta {
  background: transparent;
}

.alumni-profile-editor {
  background: transparent;
}

.alumni-profile-editor-top {
  position: sticky;
  top: 0;
  z-index: 15;
  margin-inline: -2px;
  padding: 12px 2px;
  background: color-mix(in srgb, var(--app-bg) 84%, transparent);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--app-border);
}

.alumni-profile-editor-media {
  margin-top: 18px;
  overflow: hidden;
  border-radius: 26px;
  box-shadow: 0 0 0 1px var(--app-border);
}

.alumni-profile-editor-fields {
  margin-top: 18px;
}

.alumni-edit-row {
  min-height: 58px;
  padding-block: 12px;
  border-bottom: 1px solid var(--app-border);
}

.alumni-edit-row:last-child {
  border-bottom: 0;
}

.alumni-notifications-page article {
  transition:
    padding-left .18s ease,
    background-color .18s ease;
}

.alumni-notifications-page article:hover {
  padding-left: 8px;
}

@media (max-width: 639px) {
  .alumni-profile-banner {
    border-radius: 20px !important;
  }

  .alumni-profile-identity {
    margin-top: -34px;
  }

  .alumni-profile-body {
    padding-inline: 4px !important;
  }

  .alumni-profile-editor-media {
    margin-inline: -2px;
    border-radius: 22px;
  }

  .alumni-notifications-page article:hover {
    padding-left: 0;
  }
}


/* ================================================================
   ALUMNI 1.0.14 — Composición de perfil
   ================================================================ */

.alumni-profile-body {
  padding-top: 24px !important;
}

.alumni-profile-identity {
  margin-top: 0 !important;
  align-items: center;
}

.alumni-profile-avatar {
  border: 1px solid var(--app-border) !important;
  box-shadow:
    0 12px 34px color-mix(in srgb, var(--app-shadow) 66%, transparent),
    0 0 0 1px color-mix(in srgb, var(--app-border) 80%, transparent) !important;
}

.alumni-profile-header-facts {
  min-height: 24px;
  padding-right: 2px;
}

.alumni-academic-showcase {
  border-top: 1px solid var(--app-border);
  padding-top: 22px;
}

.alumni-academic-showcase .alumni-original-logo {
  transition: transform .18s ease, opacity .18s ease;
}

.alumni-academic-showcase:hover .alumni-original-logo {
  transform: translateY(-1px);
}

@media (max-width: 639px) {
  .alumni-profile-body {
    padding-top: 18px !important;
    padding-inline: 4px !important;
  }

  .alumni-profile-identity {
    margin-top: 0 !important;
    align-items: flex-start;
  }

  .alumni-profile-header-facts {
    justify-content: flex-start !important;
    padding-right: 0;
  }

  .alumni-academic-showcase {
    margin-top: 26px !important;
  }
}


/* ================================================================
   ALUMNI 1.0.15 — Editor de perfil premium
   ================================================================ */

.alumni-settings-page.is-profile-editing {
  max-width: 980px !important;
}

.alumni-settings-page.is-profile-editing .alumni-settings-layout {
  display: block !important;
}

.alumni-settings-page.is-profile-editing .alumni-settings-detail {
  width: 100%;
  max-width: none;
}

.alumni-profile-editor {
  width: 100%;
  max-width: 920px;
  margin: 0 auto;
}

.alumni-profile-editor-top {
  position: sticky;
  top: 0;
  z-index: 25;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 0 14px;
  margin: 0;
  background: color-mix(in srgb, var(--app-bg) 88%, transparent);
  backdrop-filter: blur(22px);
  border-bottom: 1px solid var(--app-border);
}

.alumni-profile-editor-top-copy {
  min-width: 0;
  flex: 1;
}

.alumni-profile-editor-top-copy p:first-child {
  font-size: 18px;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: -.035em;
  color: var(--app-text);
}

.alumni-profile-editor-top-copy p:last-child {
  margin-top: 3px;
  font-size: 10px;
  line-height: 1.4;
  font-weight: 700;
  color: var(--app-muted-2);
}

.alumni-profile-editor-media {
  margin-top: 24px;
  overflow: visible !important;
  border-radius: 0 !important;
  box-shadow: none !important;
}

.alumni-profile-editor-banner {
  overflow: hidden;
  border-radius: 26px;
  box-shadow:
    0 0 0 1px var(--app-border),
    0 20px 60px color-mix(in srgb, var(--app-shadow) 58%, transparent);
}

.alumni-profile-editor-photo-row {
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 18px 4px 0;
}

.alumni-profile-editor-avatar {
  position: relative;
  margin: 0 !important;
  width: 92px;
  height: 92px;
  flex: 0 0 92px;
  border: 1px solid var(--app-border) !important;
  box-shadow: 0 10px 28px color-mix(in srgb, var(--app-shadow) 62%, transparent);
}

.alumni-profile-editor-photo-copy {
  min-width: 0;
}

.alumni-profile-editor-photo-copy strong {
  display: block;
  font-size: 13px;
  color: var(--app-text);
}

.alumni-profile-editor-photo-copy span {
  display: block;
  margin-top: 4px;
  max-width: 420px;
  font-size: 11px;
  line-height: 1.6;
  color: var(--app-muted-2);
}

.alumni-profile-editor-fields {
  margin-top: 34px !important;
}

.alumni-editor-section {
  padding: 24px 0;
  border-top: 1px solid var(--app-border);
}

.alumni-editor-section:first-child {
  border-top: 0;
  padding-top: 0;
}

.alumni-editor-section-head {
  margin-bottom: 9px;
}

.alumni-editor-section-head p:first-child {
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .19em;
  text-transform: uppercase;
  color: var(--app-muted-3);
}

.alumni-editor-section-head p:last-child {
  margin-top: 5px;
  max-width: 620px;
  font-size: 11px;
  line-height: 1.6;
  color: var(--app-muted-2);
}

.alumni-editor-grid-2 {
  display: grid;
  grid-template-columns: minmax(0,1fr) minmax(0,1fr);
  column-gap: 34px;
}

.alumni-editor-grid-2 > * {
  min-width: 0;
}

.alumni-profile-editor .alumni-edit-row {
  min-height: 62px;
  padding: 13px 0;
  border-bottom: 1px solid var(--app-border);
  background: transparent !important;
}

.alumni-profile-editor .alumni-edit-row:hover {
  background: transparent !important;
}

.alumni-profile-editor input,
.alumni-profile-editor textarea {
  background: transparent !important;
}

@media (max-width: 1023px) {
  .alumni-settings-page.is-profile-editing {
    max-width: 820px !important;
  }
}

@media (max-width: 639px) {
  .alumni-profile-editor {
    max-width: none;
  }

  .alumni-profile-editor-top {
    padding-top: 8px;
  }

  .alumni-profile-editor-top-copy p:last-child {
    display: none;
  }

  .alumni-profile-editor-media {
    margin-top: 16px;
  }

  .alumni-profile-editor-banner {
    border-radius: 20px;
  }

  .alumni-profile-editor-photo-row {
    gap: 14px;
    padding-inline: 2px;
  }

  .alumni-profile-editor-avatar {
    width: 78px;
    height: 78px;
    flex-basis: 78px;
  }

  .alumni-editor-grid-2 {
    grid-template-columns: 1fr;
    column-gap: 0;
  }

  .alumni-editor-section {
    padding-block: 22px;
  }
}


/* ================================================================
   ALUMNI 1.0.16 — Refinamiento del editor de perfil
   ================================================================ */

.alumni-profile-editor-top {
  position: relative !important;
  top: auto !important;
  z-index: auto !important;
  padding: 4px 0 14px !important;
  margin: 0 !important;
  background: transparent !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  border-bottom: 1px solid var(--app-border) !important;
}

.alumni-profile-editor-top-copy {
  min-width: 0;
  flex: 1;
}

.alumni-profile-editor-top-copy p {
  margin: 0 !important;
  font-size: 19px !important;
  line-height: 1.2 !important;
  font-weight: 900 !important;
  letter-spacing: -.035em !important;
  color: var(--app-text) !important;
}

.alumni-profile-editor-save {
  display: inline-flex;
  height: 38px;
  align-items: center;
  gap: 7px;
  padding: 0 2px;
  border: 0;
  background: transparent;
  color: var(--app-text-soft);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: -.01em;
  transition:
    color .18s ease,
    opacity .18s ease,
    transform .18s ease;
}

.alumni-profile-editor-save svg {
  color: var(--app-accent);
}

.alumni-profile-editor-save:hover {
  color: var(--app-text);
  transform: translateY(-1px);
}

.alumni-profile-editor-save:disabled {
  opacity: .45;
  transform: none;
}

.alumni-profile-editor-photo-row {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 20px 4px 0;
}

.alumni-profile-editor-avatar-cluster {
  display: flex;
  flex: 0 0 auto;
  align-items: flex-end;
  gap: 10px;
}

.alumni-profile-editor-avatar {
  position: relative;
  width: 116px !important;
  height: 116px !important;
  flex: 0 0 116px !important;
  margin: 0 !important;
  overflow: hidden;
  border: 1px solid var(--app-border) !important;
  border-radius: 999px;
  background: var(--app-soft-strong);
  box-shadow:
    0 14px 34px color-mix(in srgb, var(--app-shadow) 62%, transparent),
    0 0 0 1px color-mix(in srgb, var(--app-border) 65%, transparent) !important;
}

.alumni-profile-editor-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  image-rendering: auto;
}

.alumni-profile-editor-camera {
  display: flex;
  width: 38px;
  height: 38px;
  flex: 0 0 38px;
  align-items: center;
  justify-content: center;
  margin-bottom: 6px;
  border: 1px solid var(--app-border);
  border-radius: 999px;
  background: var(--app-surface);
  color: var(--app-text-soft);
  box-shadow: 0 8px 20px color-mix(in srgb, var(--app-shadow) 46%, transparent);
  transition:
    border-color .18s ease,
    background-color .18s ease,
    color .18s ease,
    transform .18s ease;
}

.alumni-profile-editor-camera:hover {
  border-color: color-mix(in srgb, var(--app-accent) 38%, var(--app-border));
  background: var(--app-soft);
  color: var(--app-accent);
  transform: translateY(-1px);
}

.alumni-profile-editor-photo-copy strong {
  font-size: 13px;
  font-weight: 900;
  color: var(--app-text);
}

.alumni-editor-section-head {
  margin-bottom: 8px !important;
}

.alumni-editor-section-head h3 {
  margin: 0;
  font-size: 12px;
  line-height: 1.25;
  font-weight: 900;
  letter-spacing: -.015em;
  color: var(--app-text-soft);
}

@media (max-width: 639px) {
  .alumni-profile-editor-top {
    padding-top: 2px !important;
  }

  .alumni-profile-editor-top-copy p {
    font-size: 18px !important;
  }

  .alumni-profile-editor-save {
    font-size: 0;
    width: 38px;
    justify-content: center;
    padding: 0;
  }

  .alumni-profile-editor-save svg {
    width: 17px;
    height: 17px;
  }

  .alumni-profile-editor-photo-row {
    gap: 14px;
    padding-top: 16px;
  }

  .alumni-profile-editor-avatar {
    width: 96px !important;
    height: 96px !important;
    flex-basis: 96px !important;
  }

  .alumni-profile-editor-camera {
    width: 36px;
    height: 36px;
    flex-basis: 36px;
    margin-bottom: 4px;
  }
}


/* ================================================================
   ALUMNI 1.0.20 — Interacción Pro de Historias
   ================================================================ */

.alumni-story-viewer {
  -webkit-user-select: none;
  user-select: none;
  touch-action: manipulation;
}

.alumni-story-viewer input {
  -webkit-user-select: text;
  user-select: text;
}

/* Mantener presionado: la historia queda limpia.
   Los elementos marcados como chrome se desvanecen sin mover el layout. */
.alumni-story-chrome {
  transition:
    opacity .16s ease,
    transform .16s ease;
}

.alumni-story-viewer.is-holding .alumni-story-chrome {
  opacity: 0 !important;
  pointer-events: none !important;
}

.alumni-story-viewer.is-holding .alumni-story-chrome-top {
  transform: translateY(-5px);
}

.alumni-story-viewer.is-holding .alumni-story-chrome-bottom {
  transform: translateY(7px);
}

/* ---------------------------------------------------------------
   Respuesta Alumni — abierta/editorial, no estilo Instagram.
   --------------------------------------------------------------- */

.alumni-story-reply-shell {
  position: absolute;
  inset-inline: 0;
  bottom: 0;
  z-index: 40;
  padding:
    48px 18px
    max(16px, env(safe-area-inset-bottom));
  background:
    linear-gradient(
      to top,
      rgba(0,0,0,.76) 0%,
      rgba(0,0,0,.38) 48%,
      transparent 100%
    );
}

.alumni-story-reply-stage {
  width: 100%;
  max-width: 510px;
  margin: 0 auto;
}

.alumni-story-reply-context {
  display: flex;
  align-items: center;
  min-height: 18px;
  margin: 0 2px 7px;
  color: rgba(255,255,255,.46);
  font-size: 8px;
  line-height: 1;
  font-weight: 900;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.alumni-story-reply-context strong {
  max-width: 210px;
  margin-left: 6px;
  overflow: hidden;
  color: rgba(255,255,255,.78);
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: .04em;
}

.alumni-story-reply-row {
  display: flex;
  align-items: flex-end;
  gap: 11px;
}

.alumni-story-reply-editor {
  position: relative;
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  min-height: 48px;
  padding: 0 0 0 2px;
  border-bottom: 1px solid rgba(255,255,255,.20);
  transition:
    border-color .18s ease,
    box-shadow .18s ease;
}

.alumni-story-reply-editor::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: -1px;
  left: 0;
  height: 1px;
  background: linear-gradient(
    90deg,
    rgba(141,152,255,0),
    rgba(141,152,255,.82),
    rgba(141,152,255,0)
  );
  opacity: 0;
  transform: scaleX(.72);
  transition:
    opacity .18s ease,
    transform .18s ease;
}

.alumni-story-reply-editor.is-focused {
  border-color: rgba(255,255,255,.35);
}

.alumni-story-reply-editor.is-focused::after {
  opacity: 1;
  transform: scaleX(1);
}

.alumni-story-reply-input {
  min-width: 0;
  height: 46px;
  flex: 1;
  border: 0;
  outline: 0;
  background: transparent !important;
  color: #fff !important;
  font-size: 13px;
  font-weight: 650;
  letter-spacing: -.01em;
}

.alumni-story-reply-input::placeholder {
  color: rgba(255,255,255,.34) !important;
}

.alumni-story-reply-send {
  display: inline-flex;
  height: 36px;
  flex: 0 0 auto;
  align-items: center;
  gap: 7px;
  margin-left: 10px;
  padding: 0 2px 0 10px;
  border: 0;
  background: transparent;
  color: rgba(255,255,255,.84);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .06em;
  text-transform: uppercase;
  transition:
    color .18s ease,
    opacity .18s ease,
    transform .18s ease;
}

.alumni-story-reply-send svg {
  color: #9ba5ff;
}

.alumni-story-reply-send:not(:disabled):hover {
  color: #fff;
  transform: translateX(1px);
}

.alumni-story-reply-send:disabled {
  opacity: .24;
}

.alumni-story-reaction {
  position: relative;
  display: flex;
  width: 46px;
  height: 46px;
  flex: 0 0 46px;
  align-items: center;
  justify-content: center;
  border: 0;
  border-left: 1px solid rgba(255,255,255,.14);
  background: transparent;
  color: rgba(255,255,255,.68);
  transition:
    color .18s ease,
    transform .18s ease,
    border-color .18s ease;
}

.alumni-story-reaction:hover {
  color: #fff;
  transform: translateY(-1px);
}

.alumni-story-reaction.is-active {
  border-left-color: rgba(248,113,113,.25);
  color: #fb7185;
}

.alumni-story-like-count {
  margin: 7px 0 0 2px;
  color: rgba(255,255,255,.30);
  font-size: 9px;
  font-weight: 750;
}

@media (max-width: 639px) {
  .alumni-story-reply-shell {
    padding-inline: 16px;
  }

  .alumni-story-reply-send span {
    display: none;
  }

  .alumni-story-reply-send {
    width: 34px;
    justify-content: center;
    padding-inline: 0;
  }

  .alumni-story-reaction {
    width: 42px;
    flex-basis: 42px;
  }
}



/* ALUMNI_1_2_2_NAV_STABILITY:CSS */
.alumni-profile-page,
.alumni-feed-page,
.alumni-explore-page,
.alumni-notifications-page,
.alumni-events-page,
.alumni-settings-page {
  animation: none !important;
}


/* =========================================================
   ALUMNI 1.4.2 — THREE THEME CONTRAST AUDIT
   ========================================================= */

html[data-theme="dark"] {
  --app-bg: #090b0f;
  --app-bg-2: #0c0f15;
  --app-surface: #101318;
  --app-surface-2: #191e27;
  --app-text: #f4f4f5;
  --app-text-soft: #d4d4d8;
  --app-muted: #aeb6c3;
  --app-muted-2: #919baa;
  --app-muted-3: #7f8998;
  --app-accent: #7f8cff;
  --app-accent-2: #6d7cff;
  --app-accent-fill: linear-gradient(135deg,#6d7cff,#7f8cff);
  --app-accent-soft: rgba(109,124,255,.13);
  --app-on-accent: #ffffff;
}

html[data-theme="light"] {
  --app-bg: #f4f6fa;
  --app-bg-2: #eef1f6;
  --app-surface: #ffffff;
  --app-surface-2: #edf1f7;
  --app-soft: rgba(15,23,42,.045);
  --app-soft-strong: rgba(15,23,42,.075);
  --app-border: rgba(15,23,42,.12);
  --app-text: #10141b;
  --app-text-soft: #27303c;
  --app-muted: #4f5c6d;
  --app-muted-2: #5c697b;
  --app-muted-3: #677487;
  --app-accent: #4d60d8;
  --app-accent-2: #5267e8;
  --app-accent-fill: linear-gradient(135deg,#4d60d8,#5267e8);
  --app-accent-soft: rgba(82,103,232,.11);
  --app-on-accent: #ffffff;
  --app-topbar: rgba(255,255,255,.94);
  --app-shadow: rgba(31,41,55,.10);
}


/* Dark overlays always keep white foreground, including Light theme. */
html[data-theme] [class*="bg-black/"][class*="text-white"] {
  color: #ffffff !important;
}

/* Reply inside a sent/received bubble. */
.alumni-reply-quote {
  display: flex;
  min-width: 0;
  overflow: hidden;
  margin-bottom: 7px;
  border-left: 3px solid var(--app-accent);
  border-radius: 9px;
  background:
    color-mix(
      in srgb,
      var(--app-surface-2) 72%,
      transparent
    );
}

.alumni-reply-quote-body {
  min-width: 0;
  padding: 7px 9px;
}

.alumni-reply-author {
  overflow: hidden;
  color: var(--app-accent);
  font-size: 11px;
  font-weight: 850;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.alumni-reply-summary {
  overflow: hidden;
  max-width: 310px;
  margin-top: 2px;
  color: var(--app-text-soft);
  font-size: 13px;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.alumni-message-mine .alumni-reply-quote {
  border-left-color:
    color-mix(
      in srgb,
      var(--app-on-accent) 72%,
      transparent
    );
  background:
    color-mix(
      in srgb,
      var(--app-on-accent) 12%,
      transparent
    );
}

.alumni-message-mine .alumni-reply-author {
  color:
    color-mix(
      in srgb,
      var(--app-on-accent) 92%,
      transparent
    );
}

.alumni-message-mine .alumni-reply-summary {
  color:
    color-mix(
      in srgb,
      var(--app-on-accent) 82%,
      transparent
    );
}

/* Reply preview above composer — a strip, not a box inside a box. */
.alumni-composer-reply-preview {
  display: flex;
  min-width: 0;
  margin-bottom: 5px;
  overflow: hidden;
  border: 0;
  border-left: 3px solid var(--app-accent);
  border-radius: 8px;
  background: var(--app-soft);
  box-shadow: none;
}

.alumni-composer-reply-copy {
  min-width: 0;
  flex: 1 1 auto;
  padding: 7px 10px;
}

.alumni-composer-reply-preview .alumni-reply-author {
  font-size: 11px;
}

.alumni-composer-reply-preview .alumni-reply-summary {
  max-width: none;
  font-size: 13px;
}

.alumni-composer-reply-close {
  display: inline-flex;
  width: 38px;
  flex: 0 0 38px;
  align-items: center;
  justify-content: center;
  border: 0;
  background: transparent;
  color: var(--app-muted-2);
}

.alumni-composer-reply-close:hover {
  background: var(--app-soft-strong);
  color: var(--app-text);
}

/* Feed metrics deliberately use a more editorial Alumni language/style. */
.alumni-feed-pro .alumni-pro-stats,
.alumni-feed-pro .alumni-pro-view-comments {
  font-family:
    var(--font-geist-mono),
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace !important;
  letter-spacing: .012em;
}

.alumni-feed-pro .alumni-pro-stats {
  margin-top: 2px;
  padding-top: 5px;
  border-top: 1px solid
    color-mix(
      in srgb,
      var(--app-border) 72%,
      transparent
    );
}

/* ALUMNI_1_4_2_THEME_CHAT_PROFILE_POLISH:GLOBALS */


/* ===============================================================
   ALUMNI 1.5.0 — MESSAGING 2
   =============================================================== */

.alumni-message-bubble {
  transition:
    background-color .16s ease,
    opacity .16s ease,
    transform .12s ease;
}

.alumni-chat-stage [id^="message-"],
.alumni-chat-stage [id^="group-message-"] {
  scroll-margin-block: 110px;
}

.alumni-chat-stage .alumni-reply-quote[role="button"]:hover {
  background:
    color-mix(
      in srgb,
      var(--app-accent-soft) 72%,
      var(--app-surface-2)
    );
}

html[data-theme="light"] .alumni-message-other {
  border:
    1px solid
    var(--app-border);
}

/* ALUMNI_1_5_0_MESSAGING_2_HOME_NAV:GLOBALS */

/* ALUMNI_BRAND_LOGOS_FULL_COLOR_V1 */
.alumni-original-logo:has(.alumni-original-logo-image) { background: #fff !important; border-radius: 10px !important; padding: 3px !important; overflow: hidden !important; }
.alumni-original-logo-image { filter: none !important; mix-blend-mode: normal !important; opacity: 1 !important; }
html[data-theme] .alumni-original-logo-image { filter: none !important; mix-blend-mode: normal !important; opacity: 1 !important; }


/* ================================================================
   ALUMNI 3.1.0 — PROFESSIONAL VISUAL CORE
   Product polish only. No business logic.
   ================================================================ */

.alumni-professional-shell {
  background: var(--app-bg);
}

.alumni-professional-shell main {
  isolation: isolate;
}

/* Feed: editorial, quiet, content-first. */
.alumni-professional-shell .alumni-pro-post {
  border: 1px solid var(--app-border);
  border-radius: 16px;
  background: var(--app-surface);
  box-shadow:
    0 1px 2px color-mix(in srgb, var(--app-shadow) 42%, transparent);
  overflow: clip;
}

.alumni-professional-shell .alumni-pro-post + .alumni-pro-post {
  margin-top: 14px;
}

.alumni-professional-shell .alumni-pro-post-header {
  padding-top: 15px;
  padding-inline: 16px;
}

.alumni-professional-shell .alumni-pro-author > div a {
  font-size: 14px;
  font-weight: 700;
  letter-spacing: -0.01em;
}

.alumni-professional-shell .alumni-pro-author > div time,
.alumni-professional-shell .alumni-pro-author > div > span {
  color: var(--app-muted-2);
}

.alumni-professional-shell .alumni-pro-author > p {
  margin-top: 2px;
  font-size: 12px;
  line-height: 1.35;
  color: var(--app-muted);
}

.alumni-professional-shell .alumni-pro-caption-wrap {
  padding-inline: 16px;
}

.alumni-professional-shell .alumni-pro-caption {
  font-size: 14.5px;
  line-height: 1.55;
  letter-spacing: -0.006em;
  color: var(--app-text-soft);
}

.alumni-professional-shell .alumni-pro-caption-more,
.alumni-professional-shell .alumni-pro-view-comments {
  font-weight: 600;
}

.alumni-professional-shell .alumni-pro-actions {
  padding-inline: 14px;
}

.alumni-professional-shell .alumni-pro-actions button {
  transition:
    color .15s ease,
    background-color .15s ease,
    transform .12s ease;
}

.alumni-professional-shell .alumni-pro-actions button:active {
  transform: scale(.94);
}

.alumni-professional-shell .alumni-pro-stats,
.alumni-professional-shell .alumni-pro-comment-preview,
.alumni-professional-shell .alumni-pro-view-comments {
  padding-inline: 16px;
}

.alumni-professional-shell .alumni-pro-stats {
  font-size: 12.5px;
  color: var(--app-muted);
}

.alumni-professional-shell .alumni-pro-comment-preview {
  font-size: 13px;
}

.alumni-professional-shell .alumni-pro-carousel-arrow {
  box-shadow: none;
}

.alumni-professional-shell .alumni-pro-carousel-count {
  font-weight: 650;
  letter-spacing: -.01em;
}

/* Desktop cards stay subtle; mobile becomes native edge-to-edge. */
@media (max-width: 767px) {
  .alumni-professional-shell {
    background: var(--app-bg);
  }

  .alumni-professional-shell .alumni-pro-post {
    margin-inline: -16px;
    border-left: 0;
    border-right: 0;
    border-radius: 0;
    background: var(--app-surface);
    box-shadow: none;
  }

  .alumni-professional-shell .alumni-pro-post + .alumni-pro-post {
    margin-top: 10px;
  }

  .alumni-professional-shell .alumni-pro-post-header {
    padding-inline: 16px;
  }
}

/* Motion: quick and product-like, never decorative. */
@media (prefers-reduced-motion: no-preference) {
  .alumni-professional-shell a,
  .alumni-professional-shell button {
    transition-duration: 150ms;
  }
}

/* ALUMNI_3_1_0_PROFESSIONAL_VISUAL_CORE */


/* ================================================================
   ALUMNI_STORIES_1_3_2_OPTION_C_REAL_FIX
   Story owner header: superficie completamente limpia.
   ================================================================ */
.alumni-story-owner-clean,
.alumni-story-owner-clean::before,
.alumni-story-owner-clean::after {
  background: transparent !important;
  background-image: none !important;
  box-shadow: none !important;
  filter: none !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}

.alumni-story-owner-clean p,
.alumni-story-owner-clean strong,
.alumni-story-owner-clean span {
  text-shadow: none !important;
  box-shadow: none !important;
}

.alumni-story-owner-clean button {
  background: transparent !important;
  background-image: none !important;
  box-shadow: none !important;
  filter: none !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}


/* ================================================================
   ALUMNI_THEME_1_4_3_DARK_LIGHT_FEED_STORIES
   Contrato visual oficial: Oscuro + Claro.
   Feed y rail de Stories usan variables globales.
   El visor multimedia de Stories permanece oscuro por contraste.
   ================================================================ */

html[data-theme="dark"],
html[data-theme="light"] {
  color-scheme: light dark;
}

html[data-theme="dark"] {
  color-scheme: dark;
}

html[data-theme="light"] {
  color-scheme: light;
}

/* ---------- FEED ---------- */
html[data-theme="dark"] .alumni-feed-page,
html[data-theme="light"] .alumni-feed-page {
  color: var(--app-text);
  background: var(--app-surface) !important;
  border-color: var(--app-border) !important;
}

html[data-theme="dark"] .alumni-feed-page .alumni-pro-feed-list,
html[data-theme="light"] .alumni-feed-page .alumni-pro-feed-list,
html[data-theme="dark"] .alumni-feed-page .alumni-stories-section,
html[data-theme="light"] .alumni-feed-page .alumni-stories-section,
html[data-theme="dark"] .alumni-feed-page .alumni-pro-composer,
html[data-theme="light"] .alumni-feed-page .alumni-pro-composer,
html[data-theme="dark"] .alumni-feed-page .alumni-pro-feed-tabs,
html[data-theme="light"] .alumni-feed-page .alumni-pro-feed-tabs {
  color: var(--app-text);
  background: var(--app-surface) !important;
  border-color: var(--app-border) !important;
}

html[data-theme="light"] .alumni-feed-page .alumni-pro-post {
  color: var(--app-text);
}

html[data-theme="light"] .alumni-feed-page .alumni-pro-caption,
html[data-theme="light"] .alumni-feed-page .alumni-pro-author a,
html[data-theme="light"] .alumni-feed-page .alumni-link-preview-copy strong {
  color: var(--app-text-soft) !important;
}

html[data-theme="light"] .alumni-feed-page .alumni-pro-media-shell,
html[data-theme="light"] .alumni-feed-page .alumni-pro-image-button {
  background: var(--app-bg-2) !important;
}

html[data-theme="dark"] .alumni-feed-page .alumni-pro-media-shell,
html[data-theme="dark"] .alumni-feed-page .alumni-pro-image-button {
  background: #05070b !important;
}

/* Los badges y controles que viven ENCIMA de foto/video conservan contraste. */
.alumni-feed-page .alumni-pro-composer-preview > button,
.alumni-feed-page .alumni-pro-composer-video-badge,
.alumni-feed-page .alumni-pro-composer-order,
.alumni-feed-page .alumni-feed-video-mute {
  color: #fff !important;
}

/* ---------- STORIES RAIL ---------- */
html[data-theme="dark"] .alumni-stories-section,
html[data-theme="light"] .alumni-stories-section {
  color: var(--app-text);
}

html[data-theme="light"] .alumni-story-compact-ring-unseen,
html[data-theme="light"] .alumni-story-compact-ring-viewed,
html[data-theme="light"] .alumni-story-compact-ring-empty,
html[data-theme="light"] .alumni-story-compact-avatar {
  background: var(--app-surface) !important;
  border-color: var(--app-border) !important;
}

/* ---------- STORIES COMPOSER ---------- */
html[data-theme="dark"] .alumni-story-composer-modal {
  color: var(--app-text);
  background: rgba(0,0,0,.90) !important;
}

html[data-theme="light"] .alumni-story-composer-modal {
  color: var(--app-text);
  background: rgba(238,241,246,.94) !important;
}

html[data-theme="dark"] .alumni-story-composer-panel,
html[data-theme="light"] .alumni-story-composer-panel {
  color: var(--app-text);
  background: var(--app-surface) !important;
  border-color: var(--app-border) !important;
}

html[data-theme="light"] .alumni-story-composer-panel {
  box-shadow: 0 24px 72px rgba(15,23,42,.14) !important;
}

/*
 * El canvas/foto/video del editor puede seguir oscuro:
 * es contenido multimedia, no una superficie de navegación.
 * Los controles alrededor sí heredan el tema Claro/Oscuro.
 */
html[data-theme="light"] .alumni-story-composer-modal input,
html[data-theme="light"] .alumni-story-composer-modal textarea,
html[data-theme="light"] .alumni-story-composer-modal select {
  color: var(--app-text) !important;
  border-color: var(--app-border) !important;
}

html[data-theme="light"] .alumni-story-composer-modal input::placeholder,
html[data-theme="light"] .alumni-story-composer-modal textarea::placeholder {
  color: var(--app-muted) !important;
}

/* ---------- ACCESIBILIDAD / TRANSICIÓN ---------- */
.alumni-feed-page,
.alumni-stories-section,
.alumni-story-composer-panel {
  transition:
    background-color .18s ease,
    border-color .18s ease,
    color .18s ease;
}


/* ALUMNI_STORIES_THEME_1_4_4B_CLEAN_PUBLISH_DUAL_THEME
   Contrato oficial de tema de ALUMNI: únicamente dark / light. */
html[data-theme="dark"] { color-scheme: dark; }
html[data-theme="light"] { color-scheme: light; }

/* ALUMNI_INTERNAL_UI_1_0_DARK_LIGHT_CLEAN */

/* =========================================================
   ALUMNI Motion System 1.0
   Motion is part of the product language.
   ========================================================= */

:root {
  --alumni-motion-fast: 130ms;
  --alumni-motion-base: 180ms;
  --alumni-motion-slow: 340ms;
  --alumni-motion-ease:
    cubic-bezier(.2,.8,.2,1);
  --alumni-motion-spring:
    cubic-bezier(.16,1,.3,1);
}

.alumni-motion-route {
  width: 100%;
  min-width: 0;
  transform-origin:
    50% 18%;
  will-change:
    transform,
    opacity;
}

:where(
  button,
  a,
  input,
  textarea,
  select,
  summary,
  [role="button"],
  [tabindex]
) {
  transition:
    background-color
      var(--alumni-motion-base)
      var(--alumni-motion-ease),
    border-color
      var(--alumni-motion-base)
      var(--alumni-motion-ease),
    color
      var(--alumni-motion-base)
      var(--alumni-motion-ease),
    opacity
      var(--alumni-motion-fast)
      var(--alumni-motion-ease),
    box-shadow
      var(--alumni-motion-base)
      var(--alumni-motion-ease),
    filter
      var(--alumni-motion-fast)
      var(--alumni-motion-ease);
}

:where(
  button:not(:disabled),
  a[href],
  summary,
  [role="button"]
):active {
  filter:
    brightness(.965);
}

:where(
  input,
  textarea,
  select
):focus {
  transition-duration:
    var(--alumni-motion-fast);
}

[data-alumni-motion="press"] {
  transition:
    transform
      var(--alumni-motion-fast)
      var(--alumni-motion-ease),
    opacity
      var(--alumni-motion-fast)
      var(--alumni-motion-ease);
}

[data-alumni-motion="press"]:active {
  transform:
    scale(.975);
}

[data-alumni-motion="card"] {
  transition:
    transform
      var(--alumni-motion-base)
      var(--alumni-motion-ease),
    border-color
      var(--alumni-motion-base)
      var(--alumni-motion-ease),
    box-shadow
      var(--alumni-motion-base)
      var(--alumni-motion-ease);
}

@media (
  hover: hover
) and (
  pointer: fine
) {
  [data-alumni-motion="card"]:hover {
    transform:
      translateY(-2px);
  }
}

@media (
  prefers-reduced-motion:
  reduce
) {
  *,
  *::before,
  *::after {
    scroll-behavior:
      auto !important;
  }

  .alumni-motion-route,
  [data-alumni-motion] {
    transform:
      none !important;
    transition-duration:
      0.01ms !important;
    animation-duration:
      0.01ms !important;
    animation-iteration-count:
      1 !important;
  }
}

/* ALUMNI_MOTION_SYSTEM_1_0 */

/* =========================================================
   ALUMNI Motion Pass 2.0 — Full App
   Feed / Profile / Messages / Search / More / Events /
   Community / Modals / Lists / Loaders / Dynamic content
   ========================================================= */

:root {
  --alumni-motion-fast: 130ms;
  --alumni-motion-base: 180ms;
  --alumni-motion-slow: 340ms;
  --alumni-motion-reveal: 460ms;
  --alumni-motion-ease:
    cubic-bezier(.2,.8,.2,1);
  --alumni-motion-spring:
    cubic-bezier(.16,1,.3,1);
}

/* Route transition */

.alumni-motion-route {
  width: 100%;
  min-width: 0;
  transform-origin:
    50% 18%;
  will-change:
    transform,
    opacity;
}

/* Interactive micro-motion */

:where(
  button,
  a,
  input,
  textarea,
  select,
  summary,
  [role="button"],
  [tabindex]
) {
  transition:
    background-color
      var(--alumni-motion-base)
      var(--alumni-motion-ease),
    border-color
      var(--alumni-motion-base)
      var(--alumni-motion-ease),
    color
      var(--alumni-motion-base)
      var(--alumni-motion-ease),
    opacity
      var(--alumni-motion-fast)
      var(--alumni-motion-ease),
    box-shadow
      var(--alumni-motion-base)
      var(--alumni-motion-ease),
    filter
      var(--alumni-motion-fast)
      var(--alumni-motion-ease);
}

:where(
  button:not(:disabled),
  a[href],
  summary,
  [role="button"]
):active {
  filter:
    brightness(.965);
}

/* Auto motion surfaces */

[data-alumni-motion-auto="true"] {
  --alumni-enter-delay:
    calc(
      var(
        --alumni-motion-order,
        0
      ) * 32ms
    );
}

[data-alumni-motion-auto="true"][
  data-alumni-motion-state="pending"
] {
  opacity: 0;
  pointer-events:
    inherit;
}

[data-alumni-motion-auto="true"][
  data-alumni-motion-state="visible"
] {
  opacity: 1;
  transform:
    translate3d(
      0,
      0,
      0
    )
    scale(1);
}

/* Cards: feed posts, profiles, events, community, cards */

[data-alumni-motion-kind="card"] {
  transform-origin:
    50% 30%;
  transition:
    opacity
      var(--alumni-motion-reveal)
      var(--alumni-motion-ease)
      var(--alumni-enter-delay),
    transform
      var(--alumni-motion-reveal)
      var(--alumni-motion-spring)
      var(--alumni-enter-delay),
    border-color
      var(--alumni-motion-base)
      var(--alumni-motion-ease),
    box-shadow
      var(--alumni-motion-base)
      var(--alumni-motion-ease);
}

[data-alumni-motion-kind="card"][
  data-alumni-motion-state="pending"
] {
  transform:
    translate3d(
      0,
      14px,
      0
    )
    scale(.992);
}

/* List rows, search results, More rows */

[data-alumni-motion-kind="row"] {
  transition:
    opacity
      390ms
      var(--alumni-motion-ease)
      var(--alumni-enter-delay),
    transform
      390ms
      var(--alumni-motion-spring)
      var(--alumni-enter-delay),
    background-color
      var(--alumni-motion-base)
      var(--alumni-motion-ease);
}

[data-alumni-motion-kind="row"][
  data-alumni-motion-state="pending"
] {
  transform:
    translate3d(
      0,
      9px,
      0
    );
}

/* Messages and comments */

[data-alumni-motion-kind="conversation"] {
  transform-origin:
    50% 50%;
  transition:
    opacity
      330ms
      var(--alumni-motion-ease)
      var(--alumni-enter-delay),
    transform
      360ms
      var(--alumni-motion-spring)
      var(--alumni-enter-delay);
}

[data-alumni-motion-kind="conversation"][
  data-alumni-motion-state="pending"
] {
  transform:
    translate3d(
      0,
      7px,
      0
    )
    scale(.996);
}

/* Modals / sheets / popovers / drawers */

[data-alumni-motion-kind="overlay"] {
  transform-origin:
    50% 100%;
  transition:
    opacity
      240ms
      var(--alumni-motion-ease),
    transform
      330ms
      var(--alumni-motion-spring);
}

[data-alumni-motion-kind="overlay"][
  data-alumni-motion-state="pending"
] {
  transform:
    translate3d(
      0,
      16px,
      0
    )
    scale(.985);
}

/* Toasts */

[data-alumni-motion-kind="toast"] {
  transition:
    opacity
      220ms
      var(--alumni-motion-ease),
    transform
      300ms
      var(--alumni-motion-spring);
}

[data-alumni-motion-kind="toast"][
  data-alumni-motion-state="pending"
] {
  transform:
    translate3d(
      0,
      -9px,
      0
    )
    scale(.98);
}

/* Empty states */

[data-alumni-motion-kind="status"] {
  transition:
    opacity
      400ms
      var(--alumni-motion-ease),
    transform
      430ms
      var(--alumni-motion-spring);
}

[data-alumni-motion-kind="status"][
  data-alumni-motion-state="pending"
] {
  transform:
    translate3d(
      0,
      10px,
      0
    )
    scale(.99);
}

/* Loaders and skeletons */

[data-alumni-motion-kind="loading"][
  data-alumni-motion-state="visible"
] {
  animation:
    alumniMotionLoadingBreathe
    1.65s
    ease-in-out
    infinite;
}

@keyframes alumniMotionLoadingBreathe {
  0%,
  100% {
    opacity: .62;
  }

  50% {
    opacity: 1;
  }
}

/* Feed reaction polish */

.alumni-post-action-button,
.alumni-pro-action,
[class*="reaction"],
[class*="like-button"],
[class*="repost-button"] {
  transform-origin:
    50% 50%;
  transition:
    transform
      var(--alumni-motion-fast)
      var(--alumni-motion-spring),
    color
      var(--alumni-motion-fast)
      var(--alumni-motion-ease),
    background-color
      var(--alumni-motion-fast)
      var(--alumni-motion-ease);
}

.alumni-post-action-button:active,
.alumni-pro-action:active,
[class*="reaction"]:active,
[class*="like-button"]:active,
[class*="repost-button"]:active {
  transform:
    scale(.91);
}

/* Profile controls */

[class*="profile"] button:active,
[class*="profile"] a:active {
  transform:
    scale(.975);
}

/* Search results */

[class*="search"] [class*="result"],
[class*="explore"] [class*="result"] {
  transform-origin:
    50% 50%;
}

/* Mobile navigation */

[data-alumni-mobile-nav="true"] {
  animation:
    alumniMotionNavEnter
    420ms
    var(--alumni-motion-spring)
    both;
}

[data-alumni-mobile-nav="true"]
.alumni-mobile-nav-icon {
  transition:
    transform
      var(--alumni-motion-fast)
      var(--alumni-motion-spring),
    background-color
      var(--alumni-motion-base)
      var(--alumni-motion-ease),
    color
      var(--alumni-motion-base)
      var(--alumni-motion-ease);
}

[data-alumni-mobile-nav="true"]
.alumni-mobile-nav-item[
  data-active="true"
]
.alumni-mobile-nav-icon {
  transform:
    translateY(-1px)
    scale(1.045);
}

[data-alumni-mobile-nav="true"]
.alumni-mobile-nav-item:active
.alumni-mobile-nav-icon {
  transform:
    scale(.91);
}

@keyframes alumniMotionNavEnter {
  from {
    opacity: 0;
    transform:
      translate(
        -50%,
        10px
      )
      scale(.985);
  }

  to {
    opacity: 1;
    transform:
      translate(
        -50%,
        0
      )
      scale(1);
  }
}

/* Media polish */

img,
video {
  transition:
    opacity
      var(--alumni-motion-base)
      var(--alumni-motion-ease),
    filter
      var(--alumni-motion-base)
      var(--alumni-motion-ease);
}

/* Focus feedback */

:where(
  input,
  textarea,
  select
):focus {
  transition-duration:
    var(--alumni-motion-fast);
}

/* Manual utilities for all future work */

[data-alumni-motion="press"] {
  transition:
    transform
      var(--alumni-motion-fast)
      var(--alumni-motion-spring),
    opacity
      var(--alumni-motion-fast)
      var(--alumni-motion-ease);
}

[data-alumni-motion="press"]:active {
  transform:
    scale(.975);
}

[data-alumni-motion="card"] {
  transition:
    transform
      var(--alumni-motion-base)
      var(--alumni-motion-spring),
    border-color
      var(--alumni-motion-base)
      var(--alumni-motion-ease),
    box-shadow
      var(--alumni-motion-base)
      var(--alumni-motion-ease);
}

@media (
  hover: hover
) and (
  pointer: fine
) {
  [data-alumni-motion="card"]:hover {
    transform:
      translateY(-2px);
  }
}

/* Accessibility */

@media (
  prefers-reduced-motion:
  reduce
) {
  *,
  *::before,
  *::after {
    scroll-behavior:
      auto !important;
  }

  .alumni-motion-route,
  [data-alumni-motion],
  [data-alumni-motion-auto],
  [data-alumni-mobile-nav="true"] {
    animation:
      none !important;
    transform:
      none !important;
    transition-duration:
      .01ms !important;
    transition-delay:
      0ms !important;
  }

  [data-alumni-motion-auto] {
    opacity:
      1 !important;
  }
}

/* ALUMNI_MOTION_SYSTEM_1_0 */
/* ALUMNI_MOTION_PASS_2_0_FULL_APP */

/* =========================================================
   ALUMNI Visual Language 1.0
   Inspired by Developer showcase clarity.
   Reusable premium page language for the rest of the app.
   ========================================================= */

.alumni-page-premium-hero {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--app-border);
  border-radius: 26px;
  background: var(--app-surface);
}

.alumni-page-premium-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 28px;
  padding: 0 10px;
  border-radius: 999px;
  background:
    color-mix(
      in srgb,
      var(--app-accent) 10%,
      transparent
    );
  color: var(--app-accent);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.alumni-page-premium-section-title small {
  display: block;
  margin-bottom: 7px;
  color: var(--app-accent);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.alumni-page-premium-section-title h2 {
  margin: 0;
  color: var(--app-text);
  font-size: clamp(24px, 7vw, 32px);
  line-height: 1.05;
  font-weight: 940;
  letter-spacing: -0.045em;
}

.alumni-page-premium-section-title p {
  margin: 10px 0 0;
  color: var(--app-muted);
  font-size: 12px;
  line-height: 1.65;
}

.alumni-page-premium-list {
  overflow: hidden;
  border: 1px solid var(--app-border);
  border-radius: 22px;
  background: var(--app-surface);
}

.alumni-page-premium-row {
  display: grid;
  grid-template-columns: 42px minmax(0, 1fr) 18px;
  align-items: center;
  gap: 12px;
  min-height: 80px;
  padding: 14px 16px;
  border-top: 1px solid var(--app-border);
}

.alumni-page-premium-row:first-child {
  border-top: 0;
}

/* ALUMNI_VISUAL_LANGUAGE_1_0_MORE_GROUPED */

/* =========================================================
   ALUMNI Visual Pass 2.0
   Developer-showcase inspired visual language
   ========================================================= */

:root {
  --vp-wash:
    color-mix(
      in srgb,
      var(--app-accent) 9%,
      transparent
    );
  --vp-line:
    color-mix(
      in srgb,
      var(--app-accent) 26%,
      var(--app-border)
    );
}

/* ---------------------------------------------------------
   Shared premium language
   --------------------------------------------------------- */

.alumni-feed-page,
.alumni-profile-launch,
.alumni-explore-pro,
.alumni-messages-page,
.alumni-settings-classic,
.alumni-events-2,
.alumni-community-2,
.alumni-notifications-pro {
  color:
    var(--app-text);
}

:is(
  .alumni-explore-hero,
  .alumni-inbox-header,
  .events2-hero,
  .community2-hero,
  .alumni-notifications-header
) {
  position: relative;
  isolation: isolate;
}

:is(
  .events2-hero,
  .community2-hero
) {
  overflow: hidden;
  padding:
    24px 20px;
  border:
    1px solid
    var(--app-border);
  border-radius:
    24px;
  background:
    var(--app-surface);
}

:is(
  .events2-hero,
  .community2-hero
)::after {
  content: "";
  position: absolute;
  z-index: -1;
  top: -82px;
  right: -72px;
  width: 170px;
  height: 170px;
  border:
    1px solid
    var(--vp-line);
  border-radius: 50%;
  pointer-events: none;
}

:is(
  .events2-hero,
  .community2-hero
) h1 {
  font-size:
    clamp(
      30px,
      8vw,
      40px
    );
  font-weight: 950;
  letter-spacing:
    -.05em;
}

/* ---------------------------------------------------------
   Back buttons: same clarity as Developer
   --------------------------------------------------------- */

:is(
  .alumni-profile-launch-cover-action.is-back,
  .alumni-settings-classic-back,
  .alumni-settings-detail-header > button,
  .alumni-about-back,
  .alumni-help-header > button
) {
  transition:
    transform
      150ms
      cubic-bezier(.2,.8,.2,1),
    background-color
      160ms
      ease,
    border-color
      160ms
      ease;
}

:is(
  .alumni-profile-launch-cover-action.is-back,
  .alumni-settings-classic-back,
  .alumni-settings-detail-header > button,
  .alumni-about-back,
  .alumni-help-header > button
):active {
  transform:
    scale(.92);
}

/* ---------------------------------------------------------
   Feed
   --------------------------------------------------------- */

.alumni-feed-page
.alumni-pro-composer {
  overflow: hidden;
  border:
    1px solid
    var(--app-border);
  border-radius:
    21px;
  background:
    var(--app-surface);
  box-shadow:
    0 12px 34px
    color-mix(
      in srgb,
      var(--app-shadow) 42%,
      transparent
    );
}

.alumni-feed-page
.alumni-pro-feed-tabs {
  margin-top: 12px;
  margin-bottom: 14px;
  padding: 4px;
  border:
    1px solid
    var(--app-border);
  border-radius:
    15px;
  background:
    var(--app-surface);
}

.alumni-feed-page
.alumni-pro-feed-tabs
button {
  min-height: 38px;
  border-radius: 11px;
}

.alumni-feed-page
.alumni-pro-feed-tabs
button[data-active="true"] {
  background:
    var(--vp-wash);
  color:
    var(--app-accent);
}

.alumni-feed-page
.alumni-feed-post-viewport {
  margin-bottom:
    13px;
}

.alumni-feed-page
.alumni-pro-toast {
  border:
    1px solid
    var(--vp-line);
  border-radius:
    14px;
  background:
    color-mix(
      in srgb,
      var(--app-surface) 96%,
      transparent
    );
  box-shadow:
    0 16px 40px
    var(--app-shadow);
  backdrop-filter:
    blur(16px);
}

/* ---------------------------------------------------------
   Profile — avatar must always remain visible
   --------------------------------------------------------- */

.alumni-profile-launch-hero {
  position: relative;
  isolation: isolate;
}

.alumni-profile-launch-header,
.alumni-profile-launch-avatar-row,
.alumni-profile-launch-avatar-wrap {
  overflow: visible !important;
}

.alumni-profile-launch-avatar-row {
  position: relative;
  z-index: 8;
}

.alumni-profile-launch-avatar-wrap {
  top: -42px !important;
  z-index: 12;
  opacity: 1 !important;
  visibility: visible !important;
  transform: none !important;
}

.alumni-profile-launch-avatar {
  position: relative;
  z-index: 3;
  opacity: 1 !important;
  visibility: visible !important;
  border:
    3px solid
    var(--app-bg);
  box-shadow:
    0 10px 30px
    rgba(0,0,0,.28);
}

.alumni-profile-launch-avatar
.alumni-image-shell,
.alumni-profile-launch-avatar
.alumni-image-element,
.alumni-profile-launch-avatar
button {
  display: block;
  width: 100%;
  height: 100%;
  opacity: 1 !important;
  visibility: visible !important;
}

.alumni-profile-launch-camera {
  z-index: 14;
}

.alumni-profile-launch-actions
> * {
  transition:
    transform
      140ms
      cubic-bezier(.2,.8,.2,1),
    border-color
      160ms
      ease,
    background-color
      160ms
      ease;
}

.alumni-profile-launch-actions
> *:active {
  transform:
    scale(.975);
}

.alumni-profile-launch-stats {
  margin-top: 18px;
  border-top:
    1px solid
    var(--app-border);
}

.alumni-profile-launch-tabs {
  border:
    1px solid
    var(--app-border);
  border-right: 0;
  border-left: 0;
  box-shadow:
    0 8px 22px
    color-mix(
      in srgb,
      var(--app-shadow) 18%,
      transparent
    );
}

/* ---------------------------------------------------------
   Search
   --------------------------------------------------------- */

.alumni-explore-pro
.alumni-explore-hero {
  overflow: hidden;
  padding:
    23px 20px
    18px;
  border:
    1px solid
    var(--app-border);
  border-radius:
    24px;
  background:
    var(--app-surface);
}

.alumni-explore-pro
.alumni-explore-hero::after {
  content: "";
  position: absolute;
  z-index: -1;
  top: -92px;
  right: -78px;
  width: 182px;
  height: 182px;
  border:
    1px solid
    var(--vp-line);
  border-radius: 50%;
}

.alumni-explore-pro
.alumni-explore-hero h1 {
  font-size:
    clamp(
      30px,
      8vw,
      40px
    );
